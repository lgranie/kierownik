#
# Machine fragment for krw-8745 - Chuwi AuBox 8745 (Zen 4 / Radeon 780M).
# Merged last, over the shared layers, at build time (this file wins).
# Only options that differ from the shared base live here.

# --- CPU (Zen 4) ---
CONFIG_NR_CPUS=16
CONFIG_CPU_SUP_AMD=y
# CONFIG_CPU_SUP_INTEL is not set
# CONFIG_CPU_SUP_HYGON is not set
# CONFIG_CPU_SUP_CENTAUR is not set
# CONFIG_CPU_SUP_ZHAOXIN is not set
CONFIG_X86_AMD_PSTATE=y

# --- Thermal / platform ---
CONFIG_SENSORS_K10TEMP=m
CONFIG_SENSORS_NCT6775=m
CONFIG_AMD_PMC=m
CONFIG_PINCTRL_AMD=y

# --- ACPI (physical power button for logind) ---
CONFIG_ACPI_BUTTON=y

# --- Virtualization (KVM host for qemu) ---
CONFIG_KVM=m
CONFIG_KVM_AMD=m
CONFIG_VHOST_NET=m

# --- Display / GPU (Radeon 780M, RDNA 3) -------------------------------
CONFIG_DRM_AMDGPU=y
CONFIG_DRM_AMD_DC=y

# --- Networking (wired; wireless in common/workstation.config) ---
CONFIG_R8169=m
CONFIG_IGC=m
