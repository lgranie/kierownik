#
# Machine fragment for krw-8745 - Chuwi AuBox 8745 (Zen 4 / Radeon 780M).
# Merged last, over the shared layers, at build time (this file wins).
# Only options that differ from the shared base live here.

# --- CPU (Zen 4) ---
CONFIG_MZEN4=y
CONFIG_NR_CPUS=32
CONFIG_X86_AMD_PSTATE=y

# --- Thermal / platform ---
CONFIG_SENSORS_K10TEMP=m
CONFIG_SENSORS_NCT6775=m
CONFIG_AMD_PMC=m
CONFIG_PINCTRL_AMD=y

# --- Display / GPU (Radeon 780M, RDNA 3) -------------------------------
CONFIG_DRM_AMDGPU=y
CONFIG_DRM_AMD_DC=y

# --- Networking (wired; wireless in common/workstation.config) ---
CONFIG_R8169=m
CONFIG_IGC=m
