#
# Machine fragment for krw-x4cxl - Topton X4C-XL (Alder Lake-N, 4x i226-V).
# Merged last, over the shared layers, at build time (this file wins).
# Only options that differ from the shared base live here.

# --- CPU (Alder Lake-N) ---
CONFIG_MATOM=y
CONFIG_NR_CPUS=4
# CONFIG_X86_CPU_SUP_AMD is not set
CONFIG_SENSORS_CORETEMP=y
CONFIG_SENSORS_NCT6775=m

# --- Audio (MPD via USB DAC only; no HDMI/HDA output on this box) ---
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_USB_AUDIO=m

# --- Networking (4x Intel i226-V 2.5GbE) -------------------------------
CONFIG_IGC=y

# --- No I2C consumers on this box (touchscreen/bus live in intel.config for 5290) ---
# CONFIG_I2C is not set
