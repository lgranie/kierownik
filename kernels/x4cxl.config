#
# Machine fragment for krw-x4cxl - Topton X4C-XL (Alder Lake-N, 4x i226-V).
# Merged over kernels/common.config at build time (this file wins on conflict).
# Only options that differ from the shared base live here.

# --- CPU (Alder Lake-N) ---
CONFIG_MATOM=y
CONFIG_NR_CPUS=8
CONFIG_X86_INTEL_PSTATE=y
CONFIG_X86_PKG_TEMP_THERMAL=y
CONFIG_SENSORS_CORETEMP=y
CONFIG_SENSORS_NCT6775=m
CONFIG_INTEL_IDLE=y

# --- ACPI ---
CONFIG_ACPI_BUTTON=y

# --- Input / display (headless, i915 kept for the i915 kargs) ---
CONFIG_I2C=y
CONFIG_DRM_I915=y

# --- Networking (4x Intel i226-V 2.5GbE) -------------------------------
CONFIG_IGC=y
