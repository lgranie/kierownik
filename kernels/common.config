#
# Shared base kernel configuration for all krw machines (hardware platform,
# drivers, disk formats). The bootc/container stack lives in
# kernels/common/bootc.config, machine deltas in kernels/<machine>.config.
# Merged at build time (later files win):
#   ./scripts/kconfig/merge_config.sh -m -O <srcdir> <srcdir>/.config \
#     kernels/common/bootc.config kernels/<machine>.config
#   make -C <srcdir> olddefconfig
#
# Only options identical on every machine live here. CPU tuning (M*),
# NR_CPUS, GPU driver, NIC, sensors, wifi/bt stay in the machine fragments.
# Every option missing from all files gets its Kconfig default via olddefconfig.
# --- Architecture / CPU -----------------------------------------------
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_X86=y
CONFIG_X86_CPU_SUP_INTEL=y
CONFIG_X86_CPU_SUP_AMD=y
CONFIG_SMP=y
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_PREEMPT=y
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_PAGE_TABLE_ISOLATION=y
CONFIG_RETPOLINE=y
CONFIG_UNWINDER_ORC=y
CONFIG_X86_X2APIC=y

# --- ACPI / Power management ------------------------------------------
CONFIG_ACPI=y
CONFIG_ACPI_THERMAL=y
CONFIG_ACPI_FAN=y
CONFIG_ACPI_SLEEP=y
CONFIG_PM=y
CONFIG_PM_SLEEP=y
CONFIG_SUSPEND=y
# CONFIG_HIBERNATION is not set
CONFIG_CPU_IDLE=y

# --- CPU frequency / thermal ------------------------------------------
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_X86_ACPI_CPUFREQ=y
CONFIG_THERMAL=y
CONFIG_HWMON=y

# --- PCI / EFI / boot --------------------------------------------------
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIEPORTBUS=y
CONFIG_EFI=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# --- Exec formats / symbols (namespaces/BPF live in common/bootc.config) ---
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_KALLSYMS=y

# --- Block / storage ---------------------------------------------------
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_DM_ZERO=y
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y

# --- USB / input -------------------------------------------------------
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_HID=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_MOUSE_PS2=y

# --- Display (base; GPU driver in machine fragment) ---
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# CONFIG_SYSFB_SIMPLEFB is not set
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SIMPLEDRM=y

# --- Filesystems -------------------------------------------------------
CONFIG_EXT4_FS=y
CONFIG_XFS_FS=y
CONFIG_BTRFS_FS=m
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_UTF8=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CMOS=y

# --- Crypto ------------------------------------------------------------
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_USER_API=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y

# --- Modules / debug ---------------------------------------------------
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# CONFIG_MODULE_SIG is not set
# CONFIG_MODULE_SIG_FORCE is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_BTF is not set

# --- Release -----------------------------------------------------------
CONFIG_LOCALVERSION="-kierownik"
CONFIG_LOCALVERSION_AUTO=n
