#
# bootc / container-host base. Hardware-independent options the bootc image
# model (ostree deploy, initramfs, EFI) and the container stack (namespaces,
# cgroups, BPF, SELinux/seccomp, overlayfs, podman networking) require on
# every machine. Merged between kernels/common.config and the machine
# fragment at build time (later files win on conflict).
#
# --- bootc deploy: initrd / EFI (dracut pins compress="zstd", so only zstd + common fallbacks stay) ---
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
CONFIG_RD_XZ=y
# CONFIG_RD_LZO is not set
CONFIG_RD_LZ4=y
CONFIG_RD_ZSTD=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- bootc/containers: namespaces & IPC ---
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_TIME_NS=y
CONFIG_CGROUP_NS=y
CONFIG_NSFS=y

# --- bootc/containers: cgroups & BPF ---
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_MEMCG=y
CONFIG_MEMCG_KMEM=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y

# --- bootc/containers: security ---
CONFIG_SECURITY=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_KEYS=y

# --- bootc/containers: runtime filesystems ---
CONFIG_OVERLAY_FS=y
# composefs images mount in the initramfs; =y avoids any module/initramfs ordering hazard
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP_ZSTD=y
CONFIG_FS_VERITY=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_FUSE_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_INODE64=y
CONFIG_HUGETLBFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_FHANDLE=y
CONFIG_BINFMT_MISC=y
CONFIG_IO_URING=y

# --- bootc/containers: networking ---
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_INET=y
CONFIG_INET_DIAG=y
CONFIG_IPV6=y
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_MASQUERADE=y
CONFIG_NF_TABLES=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_COUNTER=y
CONFIG_NFT_META=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_DUP_IPV4=y
CONFIG_NFT_DUP_IPV6=y
CONFIG_NFT_FWD_NETDEV=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
