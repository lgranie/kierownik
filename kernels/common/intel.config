#
# Intel base fragment (Kaby Lake / Alder Lake-N shared options).
# Only merged by Intel images (krw-5290, krw-x4cxl); krw-8745 skips it.
# Merged after common/bootc.config, before extra/machine (later files win).
#
# --- CPU ---
CONFIG_CPU_SUP_INTEL=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_X86_PKG_TEMP_THERMAL=y
CONFIG_INTEL_IDLE=y

# --- ACPI ---
CONFIG_ACPI_BUTTON=y

# --- Input / display ---
CONFIG_I2C=y
CONFIG_DRM_I915=y
