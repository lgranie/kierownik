#
# Workstation (human-I/O) fragment: wireless, audio, bluetooth.
# Only merged by the human-facing images (krw-5290, krw-8745); the headless
# server (krw-x4cxl) skips it. Merged after common/bootc.config, before the
# machine fragment (later files win on conflict).
#
# --- wireless ---
CONFIG_WIRELESS=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_RFKILL=y
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m

# --- audio (laptop speakers + USB; no HDMI audio use) ---
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_CODEC_REALTEK=y
# CONFIG_SND_HDA_CODEC_HDMI is not set
CONFIG_SND_HDA_CODEC_GENERIC=y
CONFIG_SND_USB_AUDIO=m

# --- bluetooth (Intel/AMD cards are USB-attached; no UART BT on these machines) ---
CONFIG_BT=m
CONFIG_BT_HCIBTUSB=m
# CONFIG_BT_HCIBTUART is not set
