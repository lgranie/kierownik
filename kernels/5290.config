#
# Machine fragment for krw-5290 - Dell Latitude 5290 2-in-1 (Kaby Lake / UHD 620).
# Merged last, over the shared layers, at build time (this file wins).
# Only options that differ from the shared base live here.

# --- CPU (Kaby Lake) ---
CONFIG_GENERIC_CPU=y
CONFIG_NR_CPUS=8
# CONFIG_X86_CPU_SUP_AMD is not set
CONFIG_SENSORS_CORETEMP=m

# --- ACPI (laptop) ---
CONFIG_ACPI_VIDEO=y
CONFIG_ACPI_BATTERY=y

# --- Power: hibernation (S4; matches cpu/hibernation/* kargs + dracut resume) ---
CONFIG_SWAP=y
CONFIG_HIBERNATION=y

# --- Input (touchscreen + touchpad: HID, I2C bus, PCH GPIO for interrupts) ---
CONFIG_HID_MULTITOUCH=y
CONFIG_I2C_HID_ACPI=y
CONFIG_COMMON_CLK=y
CONFIG_I2C_DESIGNWARE_CORE=m
CONFIG_I2C_DESIGNWARE_PLATFORM=m
# pinctrl subsystem (default off) gates PINCTRL_SUNRISEPOINT and the GPIO IRQ
# controller the I2C-HID touchpad/touchscreen rely on.
CONFIG_PINCTRL=y
CONFIG_PINCTRL_SUNRISEPOINT=m

# --- Laptop platform (Dell WMI hotkeys, microSD slot) ---
CONFIG_X86_PLATFORM_DRIVERS_DELL=y
# ACPI_WMI is a bool (not tristate), so =m is coerced to =y; pin it correctly.
CONFIG_ACPI_WMI=y
CONFIG_DELL_SMBIOS=m
CONFIG_DELL_WMI=m
CONFIG_MMC=m
CONFIG_MMC_SDHCI=m
CONFIG_MMC_SDHCI_ACPI=m

# --- Sensors (2-in-1 orientation/light): off, no consumer (no iio-sensor-proxy) ---
# CONFIG_IIO is not set
# CONFIG_HID_SENSOR_HUB is not set
# CONFIG_HID_SENSOR_ACCEL_3D is not set
# CONFIG_HID_SENSOR_GYRO_3D is not set
# CONFIG_HID_SENSOR_ALS is not set

# --- Display / GPU (Intel UHD 620) -------------------------------------
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# --- Networking (wired; wireless in common/workstation.config) ---
# CONFIG_R8169 is not set
CONFIG_E1000E=m

# --- USB-C (dock/display via DP alt mode; UCSI is ACPI-enumerated since Skylake) ---
CONFIG_TYPEC=m
CONFIG_USB_ROLE_SWITCH=m
CONFIG_TYPEC_UCSI=m
CONFIG_UCSI_ACPI=m
CONFIG_TYPEC_DP_ALTMODE=m
