#!/usr/bin/env bash
#MISE description="Build bootc-native installer ISO (registry-based, needs network at install time)"
#USAGE arg "<target>" help="Target profile" { choices "X4CXL" "8745" "5290" }
set -oue pipefail

IMGREF="ghcr.io/lgranie/krw-${usage_target}:latest"
FEDORA_VERSION="${FEDORA_VERSION:-44}"
ISO_DIR="/tmp/output/iso-bootc"
KICKSTART_TMP="$(mktemp)"
trap 'rm -f "$KICKSTART_TMP"' EXIT

mkdir -p "$ISO_DIR"

# Render the kickstart with the per-target image reference
sed "s|__IMGREF__|${IMGREF}|g" ./bib/ks/bootc.ks > "$KICKSTART_TMP"

# Obtain a generic Fedora installer ISO (Anaconda >= 44 supports the bootc command)
if [ -n "${FEDORA_ISO_URL:-}" ]; then
    BASE_ISO="$(basename "$FEDORA_ISO_URL")"
    if [ ! -f "$ISO_DIR/$BASE_ISO" ]; then
        echo "Downloading generic installer ISO from $FEDORA_ISO_URL"
        curl -fL -o "$ISO_DIR/$BASE_ISO" "$FEDORA_ISO_URL"
    fi
else
    LIST_URL="https://download.fedoraproject.org/pub/fedora/linux/releases/${FEDORA_VERSION}/Server/x86_64/iso/"
    BASE_ISO="$(curl -fsSL "$LIST_URL" | grep -oP 'Fedora-Server-netinst-x86_64-'"${FEDORA_VERSION}"'-\d+\.\d+\.iso' | sort -V | tail -1)"
    if [ -z "$BASE_ISO" ]; then
        echo "Could not determine the Fedora ${FEDORA_VERSION} Server netinst ISO; set FEDORA_ISO_URL to override." >&2
        exit 1
    fi
    URL="${LIST_URL}${BASE_ISO}"
    if [ ! -f "$ISO_DIR/$BASE_ISO" ]; then
        echo "Downloading generic installer ISO from $URL"
        curl -fL -o "$ISO_DIR/$BASE_ISO" "$URL"
    fi
fi

# Inject the kickstart using mkksiso inside a container (avoids host installs
# of lorax/xorriso/isomd5sum). Runs as root for the UEFI efiboot rebuild.
echo "Injecting kickstart (imgref: $IMGREF) into $BASE_ISO"
cp "$KICKSTART_TMP" "$ISO_DIR/kickstart.ks"
run0 podman build -t localhost/krw-mkksiso -f Containerfile bib/mkksiso
run0 podman run --rm --privileged \
    --security-opt label=type:unconfined_t \
    -v /dev:/dev \
    -v "$ISO_DIR":/output \
    localhost/krw-mkksiso \
    mkksiso /output/kickstart.ks \
    "/output/$BASE_ISO" \
    "/output/krw-${usage_target}.iso"
rm -f "$ISO_DIR/kickstart.ks"

echo "Done: $ISO_DIR/krw-${usage_target}.iso"
