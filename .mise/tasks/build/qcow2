#!/usr/bin/env bash
#MISE description="Build QCOW2 disk image for VM"
#USAGE arg "<target>" help="Target profile" { choices "5290" "8745" "vm" "x4cxl"}
set -oue pipefail
# shellcheck source=build/_oci_ref
source "$(dirname "$0")/_oci_ref"

mkdir -p /tmp/output

IMGREF="$(oci_ref "${usage_target}")"

# bcvk to-disk mounts the local container storage into the install VM and
# references the source image via containers-storage:, so the image must be
# present in local (current-user) storage, not just root storage.
oci_ensure_local "$IMGREF" "${usage_target}"

OUT="/tmp/output/krw-${usage_target}.qcow2"
rm -f "$OUT"

# bcvk to-disk boots an ephemeral VM from the source image, attaches the target
# disk as virtio-blk, and runs `bootc install to-disk` inside it. Disk size is
# auto-calculated (2x source image size, 4GB minimum).
bcvk to-disk \
  --format qcow2 \
  --filesystem "${ROOTFS}" \
  "$IMGREF" "$OUT"

user_id=$(id -u)
run0 bash -c "chown -R ${user_id} /tmp/output"

echo "Done: ${OUT}"
