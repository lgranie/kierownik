#!/usr/bin/env bash
#MISE description="Build unattended bootc installer ISO (live installer via bootc-generic-iso)"
#USAGE arg "<target>" help="Target profile" { choices "N100" "8745" "5290" }
set -oue pipefail

IMGREF="ghcr.io/lgranie/krw-${usage_target}:latest"
CONTEXT="/tmp/output/iso-bootc-context"
BUILD_DIR="/tmp/output/iso"

mkdir -p "$CONTEXT" "$BUILD_DIR"

# Stage the installer container build context with the per-target kickstart
cp -a ./bib/installer/. "$CONTEXT/"
sed "s|__IMGREF__|${IMGREF}|g" ./bib/installer/src/interactive-defaults.ks \
    > "$CONTEXT/src/interactive-defaults.ks"

echo "Pulling payload image $IMGREF"
run0 podman pull "$IMGREF"

echo "Building installer-environment container krw-${usage_target}-installer"
run0 podman build --pull=newer -t "krw-${usage_target}-installer" "$CONTEXT"

echo "Building bootc-generic-iso installer for $IMGREF"
run0 podman run --rm --privileged --pull=newer \
    --security-opt label=type:unconfined_t \
    -v "$BUILD_DIR":/output \
    -v /var/lib/containers/storage:/var/lib/containers/storage \
    -v /boot:/boot \
    "${IMAGE_BUILDER}" \
    build \
    --output-dir /output \
    --bootc-ref "localhost/krw-${usage_target}-installer" \
    --bootc-installer-payload-ref "$IMGREF" \
    --bootc-default-fs btrfs \
    bootc-generic-iso

echo "Done: $BUILD_DIR/install.iso"
