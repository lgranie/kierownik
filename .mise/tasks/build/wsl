#!/usr/bin/env bash
#MISE description="Build WSL image"
set -oue pipefail

: "${BB_REGISTRY:?BB_REGISTRY missing}"

mkdir -p /tmp/output/wsl

IMAGE="${BB_REGISTRY}/krw-wsl:latest"
TARBALL=/tmp/output/wsl/krw-wsl.tar
WSL_IMAGE=/tmp/output/wsl/krw.wsl

# Build OCI image first (tags IMAGE locally)
bluebuild build recipes/krw-wsl.yml

# Prefer local build output; pull only when local image missing
if podman image exists "${IMAGE}"; then
  gum log --time=false --level info "Using local image."
  gum style "${IMAGE}"
else
  gum log --time=false --level info "Local image missing, pulling remote."
  podman pull "${IMAGE}"
fi

ctr="$(podman create "${IMAGE}")"
trap 'podman rm "${ctr}" >/dev/null' EXIT
podman export -o "${TARBALL}" "${ctr}"
podman rm "${ctr}" >/dev/null
trap - EXIT

# Compress to .wsl format
zstd "${TARBALL}" -o "${WSL_IMAGE}" --force
gum log --time=false --level info "WSL image created at /tmp/output/wsl/krw.wsl"
