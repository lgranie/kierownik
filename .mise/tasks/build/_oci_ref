#!/usr/bin/env bash
# Shared by build tasks; sourced, not executed directly.
# Usage: source "$(dirname "$0")/_oci_ref"
# shellcheck shell=bash

# Branch tag: latest on main, branch name otherwise.
oci_tag() {
  local branch
  branch=$(git branch --show-current)
  if [ "$branch" != "main" ] && [ -n "$branch" ]; then
    printf '%s' "$branch"
  else
    printf 'latest'
  fi
}

# Full image ref for a target profile.
oci_ref() {
  printf 'ghcr.io/lgranie/krw-%s:%s' "$1" "$(oci_tag)"
}

# Ensure a bootc image ref is available in the local (current-user) container storage.
# bcvk to-disk mounts the local storage path into the install VM and references
# the source image via containers-storage:, so the image must live in local storage.
# Root storage is intentionally not consulted: builds are reproducible from the
# registry or a local build, and avoiding root storage removes a hidden failure.
oci_ensure_local() {
  local ref="$1" target="$2" base="${1%:*}"
  podman image exists "$ref" 2>/dev/null && return 0
  podman pull "$ref" 2>/dev/null && return 0
  if ! podman image exists "$ref" 2>/dev/null; then
    echo "Image missing in local storage; building $ref"
    mise run build:oci "$target"
    # build:oci only produces :latest; retag when a branch tag was requested
    if [ "$ref" != "${base}:latest" ]; then
      podman tag "${base}:latest" "$ref"
    fi
  fi
  podman image exists "$ref" 2>/dev/null || {
    echo "ERROR: $ref not available in local storage" >&2
    return 1
  }
}

oci_copy() {
  local ref="$1"
  echo "Copying local $ref to root storage"
  podman save "$ref" | run0 --pipe podman load
}
