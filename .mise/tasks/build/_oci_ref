#!/usr/bin/env bash
# Shared by build tasks; sourced, not executed directly.
# Usage: source "$(dirname "$0")/_oci_ref"
# shellcheck shell=bash

# Branch tag: latest on main, branch name otherwise.
oci_tag() {
  local branch
  branch=$(git branch --show-current)
  if [ "$branch" != "main" ] && [ -n "$branch" ]; then
    printf '%s' "$branch"
  else
    printf 'latest'
  fi
}

# Full image ref for a target profile.
oci_ref() {
  printf 'ghcr.io/lgranie/krw-%s:%s' "$1" "$(oci_tag)"
}

# Ensure a bootc image ref is visible in root container storage.
# $1 = full image ref (ghcr.io/lgranie/krw-<target>:<tag>)
# $2 = target profile (for the build:oci fallback)
# Chain: root storage -> registry pull -> local storage -> build it.
oci_ensure() {
  local ref="$1" target="$2" base="${1%:*}"
  run0 podman image exists "$ref" 2>/dev/null && return 0
  run0 podman pull "$ref" 2>/dev/null && return 0
  if ! podman image exists "$ref" 2>/dev/null; then
    echo "Image missing everywhere; building $ref"
    mise run build:oci "$target"
    # build:oci only produces :latest; retag when a branch tag was requested
    if [ "$ref" != "${base}:latest" ]; then
      podman tag "${base}:latest" "$ref"
      run0 podman tag "${base}:latest" "$ref"
      return 0
    fi
  fi
  echo "Copying local $ref to root storage"
  podman save "$ref" | run0 --pipe podman load
}

oci_copy() {
  local ref="$1"
  echo "Copying local $ref to root storage"
  podman save "$ref" | run0 --pipe podman load
}
