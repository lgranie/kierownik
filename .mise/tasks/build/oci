#!/usr/bin/env bash

#MISE description="Build OCI image"
#USAGE arg "<target>" help="Target profile" { choices "N100" "8745" "5290" }

set -oue pipefail

bluebuild build recipes/krw-"${usage_target}".yml

if [ "$(id -u)" -ne 0 ]; then
  username=$(id -un)
  run0 bash -c "podman image scp ${username}@localhost::ghcr.io/lgranie/krw-${usage_target}:latest root@localhost::"
fi
