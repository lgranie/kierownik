#!/usr/bin/env bash

#MISE description="Build OCI image"
#USAGE arg "<target>" help="Target profile" { choices "X4CXL" "8745" "5290" }

set -oue pipefail

bluebuild build recipes/krw-"${usage_target}".yml

branch=$(git branch --show-current)
if [ "$branch" != "main" ] && [ -n "$branch" ]; then
  podman tag ghcr.io/lgranie/krw-"${usage_target}":latest ghcr.io/lgranie/krw-"${usage_target}":"${branch}"
fi

if [ "$(id -u)" -ne 0 ]; then
  tag="latest"
  if [ "$branch" != "main" ] && [ -n "$branch" ]; then
    tag="$branch"
  fi
  timeout 1800 podman save ghcr.io/lgranie/krw-"${usage_target}":"${tag}" | run0 --pipe podman load
fi
