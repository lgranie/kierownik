#!/usr/bin/env bash
#MISE description="Boot ISO installer in VM via qemu"
#USAGE arg "<target>" help="Target environment" { choices "N100" "8745" "5290" }
set -oue pipefail

iso="build/krw-${usage_target}.iso"
if [ ! -f "${iso}" ]; then
  gum log -sl error "ISO not found: ${iso} (run 'mise run build:iso ${usage_target}' first)"
  exit 1
fi

disk="/tmp/output/iso-test-${usage_target}.qcow2"
vars="${disk%.qcow2}-OVMF_VARS.fd"
code="/usr/share/edk2/ovmf/OVMF_CODE.fd"
vars_template="/usr/share/edk2/ovmf/OVMF_VARS.fd"

if [ ! -f "${disk}" ]; then
  gum log -sl info "Creating disk: ${disk} (10G)"
  qemu-img create -f qcow2 "${disk}" 10G
fi

if [ ! -f "${vars}" ]; then
  gum log -sl info "Creating UEFI vars: ${vars}"
  cp "${vars_template}" "${vars}"
fi

exec qemu-system-x86_64 \
  -enable-kvm \
  -cpu host \
  -machine q35,smm=on \
  -m 8192 \
  -smp 8 \
  -drive if=pflash,format=raw,readonly=on,file="${code}" \
  -drive if=pflash,format=raw,file="${vars}" \
  -drive file="${disk}",format=qcow2,if=none,id=disk0 \
  -device virtio-blk-pci,drive=disk0 \
  -cdrom "${iso}" \
  -nic user,model=virtio-net-pci \
  -device virtio-vga-gl \
  -display gtk,gl=on \
  -device qemu-xhci \
  -device usb-tablet \
  -boot order=d,menu=on
