#!/usr/bin/env bash
#MISE description="Boot ISO installer in VM via virt-install"
#USAGE arg "<target>" help="Target environment" { choices "N100" "8745" "5290" }
set -oue pipefail

iso="build/krw-${usage_target}.iso"
if [ ! -f "${iso}" ]; then
  gum log -sl error "ISO not found: ${iso} (run 'mise run build:iso ${usage_target}' first)"
  exit 1
fi

run0 virt-install \
  --name krw-"${usage_target}"-iso \
  --boot uefi,firmware.feature0.name=secure-boot,firmware.feature0.enabled=no \
  --memory 8192 \
  --vcpus 8 \
  --disk path=/tmp/output/iso-test-"${usage_target}".qcow2,size=30 \
  --cdrom "${iso}" \
  --os-variant fedora41 \
  --network bridge=virbr0 \
  --graphics spice,gl=on \
  --video virtio,accel3d=on \
  --xml './devices/graphics/listen/@type=none' \
  --noautoconsole
