#!/usr/bin/env bash
#MISE description="Test the bootc-installer ISO in a VM via qemu"
#USAGE arg "<target>" help="Target environment" { choices "N100" "8745" "5290" }
set -oue pipefail

ISO="/tmp/output/iso-bootc/krw-${usage_target}.iso"

if [ ! -f "$ISO" ]; then
    echo "ISO not found: $ISO (build it first with: mise run build:iso-bootc ${usage_target})" >&2
    exit 1
fi

qemu-system-x86_64 \
    -machine q35,accel=kvm \
    -cpu host \
    -m 8192 \
    -smp 8 \
    -drive file=/tmp/output/qcow2/disk-"${usage_target}".qcow2,format=qcow2 \
    -cdrom "$ISO" \
    -bios /usr/share/edk2/ovmf/OVMF_CODE.fd \
    -netdev bridge,id=net0,br=virbr0 \
    -device virtio-net-pci,netdev=net0 \
    -spice gl=on,unix=on,addr=/tmp/spice-"${usage_target}"-install.sock \
    -device virtio-vga-gl \
    -display none
