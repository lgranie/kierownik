#!/usr/bin/env bash
#MISE description="Run raw USB installer in VM (blank target disk)"
#USAGE arg "<target>" help="Target environment" { choices "5290" "8745" "vm" "x4cxl"}
#USAGE flag "--installed" help="Boot installed target disk instead of USB"
set -oue pipefail

raw="/tmp/output/krw-${usage_target}.raw"
target="${raw%.raw}-target.qcow2"
vars="${raw%.raw}-raw-OVMF_VARS.fd"
code="/usr/share/edk2/ovmf/OVMF_CODE.fd"
vars_template="/usr/share/edk2/ovmf/OVMF_VARS.fd"

installed=false
[ "${usage_installed:-false}" = "true" ] && installed=true

if [ "$installed" = false ] && [ ! -f "${raw}" ]; then
  gum log -sl error "Raw not found: ${raw} (run 'mise run build:raw ${usage_target}' first)"
  exit 1
fi

if [ ! -f "${target}" ]; then
  if [ "$installed" = true ]; then
    gum log -sl error "Target not found: ${target} (run without --installed first)"
    exit 1
  fi
  gum log -sl info "Creating blank target: ${target}"
  qemu-img create -f qcow2 "${target}" 30G
fi

if [ ! -f "${vars}" ]; then
  gum log -sl info "Creating UEFI vars: ${vars}"
  cp "${vars_template}" "${vars}"
fi

disk_args=(
  -drive "file=${target},format=qcow2,if=none,id=disk0"
)
if [ "$installed" = true ]; then
  gum log -sl info "Booting installed target: ${target}"
  disk_args+=(-device "virtio-blk-pci,drive=disk0,bootindex=1")
else
  gum log -sl info "Booting USB ${raw} with blank target ${target}"
  gum log -sl info "On the live system run: krw install:to-disk"
  disk_args+=(
    -device "virtio-blk-pci,drive=disk0"
    -drive "file=${raw},format=raw,if=none,id=usbdisk"
    -device "usb-storage,drive=usbdisk,bootindex=1"
  )
fi

exec qemu-system-x86_64 \
  -enable-kvm \
  -cpu host \
  -machine q35,smm=on \
  -m 8192 \
  -smp 8 \
  -drive if=pflash,format=raw,readonly=on,file="${code}" \
  -drive if=pflash,format=raw,file="${vars}" \
  -device qemu-xhci \
  "${disk_args[@]}" \
  -nic user,model=virtio-net-pci \
  -device virtio-vga-gl \
  -display gtk,gl=on \
  -device usb-tablet \
  -boot menu=on
