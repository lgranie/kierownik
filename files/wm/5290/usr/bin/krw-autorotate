#!/usr/bin/env bash
# Auto-rotate the internal panel from iio-sensor-proxy orientation.
# Rotation only (no fold/tablet-mode handling).
# Mapping left-up/right-up verified on device; swap the 1/3 pair below
# if portrait appears inverted.
set -euo pipefail

MONITOR="eDP-1"
SCALE="1.33"

if [[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
  HYPRLAND_INSTANCE_SIGNATURE="$(ls "/run/user/$(id -u)/hypr/" 2>/dev/null | head -1)"
  export HYPRLAND_INSTANCE_SIGNATURE
fi

apply() {
  local transform
  case "${1}" in
    normal) transform=0 ;;
    bottom-up) transform=2 ;;
    left-up) transform=1 ;;
    right-up) transform=3 ;;
    *) return 0 ;;
  esac
  hyprctl keyword monitor "${MONITOR},preferred,auto,${SCALE},${transform}"
  hyprctl keyword input:touchdevice:transform "${transform}"
}

monitor-sensor 2>/dev/null | while IFS= read -r line; do
  orientation="$(printf "%s" "${line}" | grep -oP '(orientation changed: |orientation: )\K[a-z-]+' || true)"
  [[ -n "${orientation}" ]] || continue
  apply "${orientation}"
done
