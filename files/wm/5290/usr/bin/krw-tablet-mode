#!/usr/bin/env bash
# Fold/tablet-mode handling for 2-in-1s (rotation excluded, see krw-autorotate).
# Watches the SW_TABLET_MODE input switch:
#   folded (1) -> disable physical kbd + touchpad, force on-screen keyboard
#   laptop (0) -> re-enable inputs, stop on-screen keyboard
# No switch on this machine -> exit quietly, nothing to do.
set -euo pipefail
shopt -s nullglob

if [[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
  HYPRLAND_INSTANCE_SIGNATURE="$(ls "/run/user/$(id -u)/hypr/" 2>/dev/null | head -1 || true)"
  export HYPRLAND_INSTANCE_SIGNATURE
fi

command -v evtest >/dev/null 2>&1 || {
  echo "krw-tablet-mode: evtest not installed" >&2
  exit 1
}
command -v hyprctl >/dev/null 2>&1 || {
  echo "krw-tablet-mode: hyprctl not installed" >&2
  exit 1
}
command -v jq >/dev/null 2>&1 || {
  echo "krw-tablet-mode: jq not installed" >&2
  exit 1
}

# Find event node exposing SW_TABLET_MODE (bit 0x01 of the SW capability mask).
node=""
for ev in /dev/input/event*; do
  base="${ev##*/}"
  raw="$(cat "/sys/class/input/${base}/device/capabilities/sw" 2>/dev/null || echo 0)"
  mask="${raw%% *}"
  [[ "${mask}" =~ ^[0-9a-fA-F]+$ ]] || continue
  if ((16#${mask} & 1)); then
    node="${ev}"
    break
  fi
done
[[ -n "${node}" ]] || exit 0

if [[ ! -r "${node}" ]]; then
  echo "krw-tablet-mode: no read access to ${node} (missing udev uaccess rule?)" >&2
  exit 1
fi

keyboards() {
  hyprctl devices -j 2>/dev/null | jq -r '.keyboards[]?.name // empty' 2>/dev/null || true
}

touchpads() {
  hyprctl devices -j 2>/dev/null | jq -r '.mice[]? | select(.name | test("touchpad|trackpad|trackpoint"; "i")) | .name' 2>/dev/null || true
}

apply() {
  if [[ "${1}" == "1" ]]; then
    while IFS= read -r dev; do
      [[ -n "${dev}" ]] || continue
      hyprctl keyword "device[${dev}]:enabled" false >/dev/null || true
    done < <({
      keyboards
      touchpads
    } || true) || true
    systemctl --user set-environment KRW_FORCE_OSK=1
    systemctl --user start wvkbd.service || true
  else
    while IFS= read -r dev; do
      [[ -n "${dev}" ]] || continue
      hyprctl keyword "device[${dev}]:enabled" true >/dev/null || true
    done < <({
      keyboards
      touchpads
    } || true) || true
    systemctl --user stop wvkbd.service 2>/dev/null || true
    systemctl --user set-environment KRW_FORCE_OSK=0
  fi
}

# evtest --query exit status reflects state; parse the printed value instead.
current="$(evtest --query "${node}" EV_SW SW_TABLET_MODE 2>/dev/null | grep -oE 'value [01]' | grep -oE '[01]' | head -1 || true)"
apply "${current:-0}"

evtest "${node}" 2>/dev/null | while IFS= read -r line; do
  if [[ "${line}" == *"SW_TABLET_MODE"* ]]; then
    value="$(printf "%s" "${line}" | grep -oE 'value [01]' | grep -oE '[01]' || true)"
    if [[ -n "${value}" ]]; then
      apply "${value}"
    fi
  fi
done
