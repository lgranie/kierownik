#!/usr/bin/env bash

set -euo pipefail

# System scope: machine-wide grants only, inherited by every user.
# Runs once (ConditionPathExists); never re-enforced, so grants stay
# removable. Inherits through the user-scope deny baseline of
# flatpak-user-lockdown; per-app exceptions there and via Flatseal.
flatpak override --system --socket=wayland --device=dri

# org.localsend.localsend_app
flatpak override --system --filesystem=xdg-download org.localsend.localsend_app

notify_all "Flatpak" "System configuration set"
