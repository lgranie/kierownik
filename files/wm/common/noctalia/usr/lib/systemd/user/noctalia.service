[Unit]
Description=Noctalia Shell.
Documentation=https://docs.noctalia.dev/v5/
ConditionUser=!@system
# order startup after WM
After=graphical-session.target wayland-session@hyprland.desktop.target

[Service]
Type=exec
# Repurpose XDG Autostart filtering
ExecCondition=/lib/systemd/systemd-xdg-autostart-condition "Hyprland" ""
ExecStart=/usr/bin/noctalia
ExecReload=kill -SIGUSR2 $MAINPID
Restart=on-failure
# Noctalia does not exit on SIGTERM during shutdown; cap the wait so
# uwsm stop (see hypr/autostart.lua) does not block for the default 45s.
TimeoutStopSec=5s
Slice=app-graphical.slice

[Install]
WantedBy=graphical-session.target
WantedBy=wayland-session@hyprland.desktop.target
