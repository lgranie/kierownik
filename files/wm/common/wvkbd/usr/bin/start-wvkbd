#!/usr/bin/env bash

set -oue pipefail

# Started and stopped by krw-tablet, which knows when the keyboard base is gone
# (and honours the manual override), so this script does not second-guess it.
PID_FILE="${XDG_RUNTIME_DIR}/wvkbd.pid"
rm -f "${PID_FILE}"

# Start hidden; --auto shows on text-input focus, hides on unfocus.
/usr/bin/wvkbd-mobintl -L 240 --hidden --auto &
PID=$!

echo "${PID}" >"${PID_FILE}"

wait "${PID}"
