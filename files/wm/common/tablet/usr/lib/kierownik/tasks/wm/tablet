#!/usr/bin/env bash

#MISE description="Tablet rotation (accelerometer, 5290 2-in-1)"
#USAGE arg "[action]" help="Rotation action" { choices "status" "auto" "normal" "right" "inverted" "left" "lock" "unlock" "probe" }
set -euo pipefail

command -v krw-tablet >/dev/null 2>&1 || {
  gum log -sl error "krw-tablet not installed. Rebuild image first."
  exit 1
}

action="${usage_action:-}"
if [[ -z "${action}" ]]; then
  action="$(gum choose --header "Tablet rotation" \
    "status" "auto" "normal" "right" "inverted" "left" "lock" "unlock" "probe")" || exit 0
fi
[[ -n "${action}" ]] || exit 0

case "${action}" in
  status | probe) krw-tablet "${action}" ;;
  auto | normal | right | inverted | left) krw-tablet rotate "${action}" ;;
  lock) krw-tablet lock on ;;
  unlock) krw-tablet lock off ;;
esac
