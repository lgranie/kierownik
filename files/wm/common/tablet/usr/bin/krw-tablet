#!/usr/bin/env bash
# krw-tablet — tablet mode for the Dell Latitude 5290 2-in-1: accelerometer
# rotation, with the panel following the machine while the keyboard base is
# gone (and the on-screen keyboard along with it).
#
# Rotation is applied to the live session with `hyprctl eval`, never with
# `hyprctl keyword`: the Hyprland configuration is Lua. The same Lua is kept in
# $HOME/.local/state/kierownik/tablet/rotation.lua, which additionals/tablet.lua
# loads after the monitor rule, so `hyprctl reload` does not straighten the
# panel. Binding a digitizer to the output maps its coordinates but does not
# rotate its axes, so every touch/pen device gets a matching transform.
#
# Tablet mode is on when any of these says so, in this order: `mode on|off`
# (manual, wins), `SW_TABLET_MODE` from the Hyprland switch binds, or the
# internal keyboard base being absent. Leaving turns the panel upright and
# stops wvkbd; only the manual override and the switch need a file, and both
# are tagged with $HYPRLAND_INSTANCE_SIGNATURE so they never leak into the next
# session. The rotation lock is tagged the same way.
#
# Subcommands:
#   daemon                          mode + rotation loop (systemd unit)
#   mode on|off|auto|toggle         tablet mode by hand, or back to signals
#   switch on|off                   switch event, called by the Hyprland binds
#   rotate normal|right|inverted|left|next|prev|auto
#   lock on|off|toggle
#   status
#   probe
#
# Entering tablet mode also asks Noctalia to keep its bar on screen: that bar
# reveals itself for a pointer at the screen edge, and a tablet has no pointer,
# so an auto-hidden bar would be unreachable by touch. Only Noctalia's runtime
# overrides are used, never its configuration, so nothing survives a rebuild of
# the session.

set -oue pipefail

# Hardcoded under $HOME (not $XDG_STATE_HOME) so this script and 5290.lua,
# which only has os.getenv("HOME"), agree on one path.
STATE_DIR="${HOME}/.local/state/kierownik/tablet"
ROTATION_STATE="${STATE_DIR}/rotation"
LOCK_STATE="${STATE_DIR}/lock"
ROTATION_LUA="${STATE_DIR}/rotation.lua"
DAEMON_LOCK="${STATE_DIR}/daemon.lock"
MODE_LOCK="${STATE_DIR}/mode.lock"
MODE_STATE="${STATE_DIR}/mode"
MANUAL_STATE="${STATE_DIR}/manual"
SWITCH_STATE="${STATE_DIR}/switch"
NOCTALIA_STATE="${STATE_DIR}/noctalia"

OUTPUT="${KRW_TABLET_OUTPUT:-eDP-1}"
INTERVAL="${KRW_TABLET_INTERVAL:-1}"
FORCE="${KRW_TABLET_FORCE:-0}"

log() { printf 'krw-tablet: %s\n' "$*" >&2; }
die() {
  log "$*"
  exit 1
}

usage() {
  cat <<'EOF'
krw-tablet — tablet mode and panel rotation for the 5290 2-in-1

Usage:
  krw-tablet daemon               mode + rotation loop (systemd unit)
  krw-tablet mode <mode>          on|off|auto|toggle
  krw-tablet switch on|off        switch event (Hyprland binds call this)
  krw-tablet rotate <mode>        normal|right|inverted|left|next|prev|auto
  krw-tablet lock on|off|toggle   freeze the current rotation
  krw-tablet status               mode, rotation, sensor and signals
  krw-tablet probe                what the session and the sensors expose

Tablet mode is on when `mode on` was given, or the tablet switch reports it,
or the keyboard base is gone. Entering also keeps the Noctalia bar on screen:
it only reveals itself for a pointer at the screen edge. Leaving turns the
panel upright, stops wvkbd and restores the bar. `mode on|off` re-applies even
when the mode already matches, which repairs what a restarted shell undid.
A fixed `rotate` and `next`/`prev` take the rotation lock; `rotate auto`
returns to the accelerometer, which is only followed in tablet mode.

Environment:
  KRW_TABLET_OUTPUT    internal panel name (default eDP-1)
  KRW_TABLET_INTERVAL  poll interval in seconds (default 1)
  KRW_TABLET_FORCE     set to 1 to treat the machine as having no keyboard
EOF
}

# --- state -----------------------------------------------------------------

write_file() {
  local path="$1" body="$2" tmp
  mkdir -p "$(dirname "$path")"
  tmp="$(mktemp "${path}.XXXXXX")" || return 1
  printf '%s\n' "$body" >"$tmp"
  mv -f "$tmp" "$path"
}

state_rotation() {
  local value=""
  [[ -r "$ROTATION_STATE" ]] && value="$(<"$ROTATION_STATE")"
  case "$value" in
    normal | right | inverted | left) printf '%s' "$value" ;;
    *) printf 'normal' ;;
  esac
}

state_mode() {
  local value
  value="$(session_value "$MODE_STATE" || true)"
  case "$value" in
    on | off) printf '%s' "$value" ;;
    *) printf '' ;;
  esac
}

# "<signature> <value>": the one kind of state that must not outlive the
# session that wrote it (a manual override, or a switch event from a machine
# that has since been rebooted).
session_value() {
  local path="$1" signature value
  [[ -r "$path" ]] || return 1
  read -r signature value <"$path" || return 1
  [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" && "$signature" == "$HYPRLAND_INSTANCE_SIGNATURE" ]] ||
    return 1
  printf '%s' "$value"
}

write_session_value() {
  [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] ||
    die "not inside a Hyprland session (HYPRLAND_INSTANCE_SIGNATURE unset)"
  write_file "$1" "${HYPRLAND_INSTANCE_SIGNATURE} $2"
}

is_locked() {
  [[ -r "$LOCK_STATE" ]] || return 1
  local signature
  signature="$(<"$LOCK_STATE")"
  [[ -n "$signature" && "$signature" == "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]
}

lock_now() {
  [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] ||
    die "not inside a Hyprland session (HYPRLAND_INSTANCE_SIGNATURE unset)"
  write_file "$LOCK_STATE" "${HYPRLAND_INSTANCE_SIGNATURE}"
}

# --- sensor ----------------------------------------------------------------

sensor_property() {
  busctl --system get-property net.hadess.SensorProxy /net/hadess/SensorProxy \
    net.hadess.SensorProxy "$1" 2>/dev/null
}

sensor_raw_orientation() {
  local raw
  raw="$(sensor_property AccelerometerOrientation)" || return 1
  raw="${raw#s }"
  raw="${raw%\"}"
  raw="${raw#\"}"
  printf '%s' "$raw"
}

# iio-sensor-proxy names the orientation by the edge of the machine pointing
# up; the transform is the counter-clockwise turn Hyprland applies to the
# panel, so the two run in opposite directions.
sensor_orientation() {
  local raw
  raw="$(sensor_raw_orientation)" || return 1
  case "$raw" in
    normal) printf 'normal' ;;
    right-up) printf 'right' ;;
    bottom-up) printf 'inverted' ;;
    left-up) printf 'left' ;;
    *) return 1 ;;
  esac
}

orientation_transform() {
  case "$1" in
    normal) printf '0' ;;
    right) printf '3' ;;
    inverted) printf '2' ;;
    left) printf '1' ;;
    *) return 1 ;;
  esac
}

# --- compositor ------------------------------------------------------------

monitor_field() {
  command -v hyprctl >/dev/null 2>&1 || return 0
  hyprctl -j monitors all 2>/dev/null | jq -r --arg output "$OUTPUT" --arg field "$1" \
    'first(.[] | select(.name == $output)) | .[$field] // empty' 2>/dev/null || true
}

monitor_mode() {
  local width height rate
  width="$(monitor_field width)"
  height="$(monitor_field height)"
  rate="$(monitor_field refreshRate)"
  if [[ "$width" =~ ^[0-9]+$ && "$height" =~ ^[0-9]+$ && "$width" != "0" && "$rate" =~ ^[0-9.]+$ ]]; then
    printf '%sx%s@%s' "$width" "$height" "$rate"
  else
    printf 'preferred'
  fi
}

monitor_scale() {
  local scale
  scale="$(monitor_field scale)"
  if [[ "$scale" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
    printf '%s' "$scale"
  else
    printf '1.33'
  fi
}

# Touchscreens are listed under "touch", pens under "tablets". Pad and tool
# entries have no name: the pad names its parent, the tool is anonymous.
tablet_devices() {
  command -v hyprctl >/dev/null 2>&1 || return 0
  local name
  hyprctl -j devices 2>/dev/null |
    jq -r '[ (.touch // [])[].name,
             ((.tablets // [])[] | select(.name != null) | .name) ]
           | map(select(. != null and . != ""))
           | unique[]' 2>/dev/null |
    while IFS= read -r name; do
      [[ -n "$name" ]] || continue
      LC_ALL=C grep -q '[[:cntrl:]]' <<<"$name" && continue
      printf '%s\n' "$name"
    done
}

lua_string() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  printf '"%s"' "$value"
}

# Mode and scale are taken from the running monitor: a per-output rule
# replaces the wildcard one, and "preferred" would drop a custom refresh rate.
rotation_statements() {
  local transform="$1" mode scale name
  mode="$(monitor_mode)"
  scale="$(monitor_scale)"

  printf 'hl.monitor({ output = %s, mode = %s, position = "auto", scale = "%s", transform = %d })\n' \
    "$(lua_string "$OUTPUT")" "$(lua_string "$mode")" "$scale" "$transform"
  printf 'hl.config({ input = { touchdevice = { output = %s, transform = %d }, tablet = { output = %s, transform = %d } } })\n' \
    "$(lua_string "$OUTPUT")" "$transform" "$(lua_string "$OUTPUT")" "$transform"
  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    printf 'hl.device({ name = %s, output = %s, transform = %d })\n' \
      "$(lua_string "$name")" "$(lua_string "$OUTPUT")" "$transform"
  done < <(tablet_devices)
}

hypr_eval() {
  local code="$1" out
  command -v hyprctl >/dev/null 2>&1 || {
    log "hyprctl not found"
    return 1
  }
  if ! out="$(hyprctl eval "$code" 2>&1)"; then
    log "hyprctl eval failed: $out"
    return 1
  fi
  if [[ "$out" != "ok" ]]; then
    log "hyprctl eval failed: $out"
    return 1
  fi
}

# The file is written before the live change: if the eval is refused, the next
# config reload still turns the panel instead of leaving state and screen
# disagreeing.
apply_rotation() {
  local orientation="$1" transform lua code
  transform="$(orientation_transform "$orientation")" || {
    log "unknown orientation: $orientation"
    return 1
  }

  lua="$(rotation_statements "$transform")"
  code="${lua//$'\n'/ }"

  if [[ "$transform" == "0" ]]; then
    rm -f "$ROTATION_LUA"
  else
    write_file "$ROTATION_LUA" "$lua"
  fi
  write_file "$ROTATION_STATE" "$orientation"

  hypr_eval "$code"
}

# --- tablet mode -----------------------------------------------------------

keyboard_attached() {
  local node
  for node in /dev/input/by-path/*-kbd; do
    [[ -e "$node" ]] && return 0
  done
  return 1
}

# An "on" claim from anywhere wins, so a switch that lies about being folded
# cannot leave a tablet keyless, and an undetected keyboard node cannot leave
# it in laptop mode. Only the manual override can hold the machine in laptop
# mode while the base is gone, and only while it is set.
desired_mode() {
  local manual switch_state
  manual="$(session_value "$MANUAL_STATE" || true)"
  case "$manual" in
    on | off)
      printf '%s' "$manual"
      return 0
      ;;
  esac
  switch_state="$(session_value "$SWITCH_STATE" || true)"
  if [[ "$switch_state" == "on" ]]; then
    printf 'on'
    return 0
  fi
  if [[ "$FORCE" == "1" ]] || ! keyboard_attached; then
    printf 'on'
    return 0
  fi
  printf 'off'
}

mode_reason() {
  local manual switch_state
  manual="$(session_value "$MANUAL_STATE" || true)"
  case "$manual" in
    on | off)
      printf 'manual'
      return 0
      ;;
  esac
  switch_state="$(session_value "$SWITCH_STATE" || true)"
  if [[ "$switch_state" == "on" ]]; then
    printf 'switch'
    return 0
  fi
  if [[ "$FORCE" == "1" ]] || ! keyboard_attached; then
    printf 'no keyboard'
    return 0
  fi
  printf 'keyboard'
}

# --- shell (Noctalia) ------------------------------------------------------

# Noctalia may be absent from the image, not running, or restarted since the
# last transition, so every call here is best effort and every override it
# gets is runtime only: nothing is written to its configuration, and a shell
# restart drops the overrides without leaving a trace. That is also why
# `mode on` re-applies instead of doing nothing when mode is already on.

noctalia_running() {
  command -v noctalia >/dev/null 2>&1 || return 1
  timeout 2 noctalia msg status >/dev/null 2>&1
}

noctalia_send() {
  # A shell that vanished between the check and the call is not worth failing
  # a mode transition over.
  noctalia msg "$@" >/dev/null 2>&1 || true
}

# $1: config section (bar, dock). The merged dump of that section.
noctalia_config() {
  noctalia msg config-get "$1" 2>/dev/null
}

# "on", "off" or "smart" as configured for the section.
noctalia_auto_hide() {
  local dump
  dump="$(noctalia_config "$1")" || return 1
  [[ -n "$dump" ]] || return 1
  if grep -qE '^[[:space:]]*smart_auto_hide = true$' <<<"$dump"; then
    printf 'smart'
  elif grep -qE '^[[:space:]]*auto_hide = true$' <<<"$dump"; then
    printf 'on'
  else
    printf 'off'
  fi
}

noctalia_dock_enabled() {
  noctalia_config dock | grep -qE '^[[:space:]]*enabled = true$'
}

noctalia_bar_visible() {
  noctalia msg status 2>/dev/null | tr -d ' \n' |
    sed -n 's/.*"barVisible":\(true\|false\).*/\1/p'
}

# "visible, auto-hide on" — the same line for status and probe.
noctalia_bar_state() {
  printf '%s, auto-hide %s' \
    "$([[ "$(noctalia_bar_visible)" == "false" ]] && printf hidden || printf visible)" \
    "$(noctalia_auto_hide bar || printf '?')"
}

noctalia_enter() {
  noctalia_running || return 0

  local auto_hide visible
  auto_hide="$(noctalia_auto_hide bar || true)"
  visible="$(noctalia_bar_visible || true)"
  [[ -n "$auto_hide" && -n "$visible" ]] || return 0

  # "<auto-hide we override> <visible before we did>", so the exit restores
  # exactly what this changed and nothing else.
  if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    [[ "$visible" == "false" ]] && visible=hidden || visible=shown
    write_session_value "$NOCTALIA_STATE" "$auto_hide $visible"
  fi

  # bar-show brings an auto-hidden (or given-up) bar back; turning auto-hide
  # off is what keeps it there while the screen is touched instead of pointed.
  [[ "$auto_hide" == "off" ]] || noctalia_send bar-auto-hide-set off
  noctalia_send bar-show
}

noctalia_exit() {
  local previous auto_hide visible
  previous="$(session_value "$NOCTALIA_STATE" || true)"
  [[ -n "$previous" ]] || return 0
  rm -f "$NOCTALIA_STATE"

  auto_hide="${previous%% *}"
  visible="${previous#* }"
  noctalia_running || return 0

  [[ "$auto_hide" == "off" ]] || noctalia_send bar-auto-hide-set "$auto_hide"
  case "$visible" in
    hidden) noctalia_send bar-hide ;;
    *) noctalia_send bar-show ;;
  esac
}

enter_mode() {
  write_session_value "$MODE_STATE" on
  systemctl --user start wvkbd.service >/dev/null 2>&1 ||
    log "could not start wvkbd.service"

  noctalia_enter

  if is_locked; then
    log "rotation locked, leaving the panel at $(state_rotation)"
    return 0
  fi

  local orientation
  if ! orientation="$(sensor_orientation)"; then
    log "no accelerometer orientation, leaving the panel at $(state_rotation)"
    return 0
  fi
  apply_rotation "$orientation" || true
}

exit_mode() {
  write_session_value "$MODE_STATE" off
  systemctl --user stop wvkbd.service >/dev/null 2>&1 ||
    log "could not stop wvkbd.service"

  noctalia_exit

  # The lock belongs to tablet mode: the base is back, so the panel stands up.
  rm -f "$LOCK_STATE"
  if [[ -f "$ROTATION_LUA" || "$(monitor_field transform)" != "0" ]]; then
    apply_rotation normal || true
  fi
}

# Locked so the daemon and a CLI call cannot transition twice at once. `force`
# re-runs the transition even when mode already matches, which is how a manual
# `mode on|off` repairs what a restart of Noctalia, wvkbd or Hyprland undid.
apply_mode() {
  (
    mkdir -p "$STATE_DIR"
    exec 9>"$MODE_LOCK"
    flock 9

    local desired current
    desired="$(desired_mode)"
    current="$(state_mode)"
    if [[ "$desired" == "$current" && "${1:-}" != "force" ]]; then
      exit 0
    fi

    if [[ "$desired" == "on" ]]; then
      log "tablet mode on ($(mode_reason))"
      enter_mode
    else
      log "tablet mode off ($(mode_reason))"
      exit_mode
    fi
  )
}

# --- commands --------------------------------------------------------------

cmd_daemon() {
  mkdir -p "$STATE_DIR"
  exec 9>"$DAEMON_LOCK"
  if ! flock -n 9; then
    log "already running"
    return 0
  fi

  local warned=0 pending="" pending_count=0 want wanted current
  local noctalia_tries=0
  while :; do
    # The switch bind, the keyboard base coming and going and `krw-tablet
    # mode` all just move the files this reads.
    apply_mode

    # Noctalia can come up after this daemon (a tablet booted with the base
    # already off), so offer it the bar settings a few more times. The marker
    # file stops this as soon as it has taken them, and the bound keeps a
    # machine where the call never succeeds from running it forever.
    if [[ "$noctalia_tries" -lt 30 && "$(state_mode)" == "on" ]] &&
      ! session_value "$NOCTALIA_STATE" >/dev/null 2>&1; then
      noctalia_tries=$((noctalia_tries + 1))
      noctalia_enter
    fi

    # Rotation only matters in tablet mode, and the lock freezes it.
    if [[ "$(state_mode)" != "on" ]] || is_locked; then
      pending=""
      pending_count=0
      sleep "$INTERVAL"
      continue
    fi

    if ! want="$(sensor_orientation)"; then
      if [[ "$warned" == "0" ]]; then
        log "no accelerometer orientation; auto-rotation idle (krw-tablet probe)"
        warned=1
      fi
      sleep "$INTERVAL"
      continue
    fi
    warned=0

    wanted="$(orientation_transform "$want")"
    current="$(monitor_field transform)"

    # No panel (lid closed, session still coming up): never turn one on.
    if [[ -z "$current" || "$current" == "$wanted" ]]; then
      pending=""
      pending_count=0
      sleep "$INTERVAL"
      continue
    fi

    # Two identical readings in a row: a machine resting on an edge flickers
    # between two orientations, and one flap is not worth a rotation.
    if [[ "$pending" == "$want" ]]; then
      pending_count=$((pending_count + 1))
    else
      pending="$want"
      pending_count=1
    fi

    if [[ "$pending_count" -ge 2 ]]; then
      log "rotating to $want (transform $wanted)"
      if apply_rotation "$want"; then
        pending=""
        pending_count=0
      fi
    fi

    sleep "$INTERVAL"
  done
}

cycle_orientation() {
  local direction="$1" current index=0 i
  local order=(normal right inverted left)
  current="$(state_rotation)"
  for i in "${!order[@]}"; do
    [[ "${order[$i]}" == "$current" ]] && index="$i"
  done
  if [[ "$direction" == "next" ]]; then
    index=$(((index + 1) % 4))
  else
    index=$(((index + 3) % 4))
  fi
  printf '%s' "${order[$index]}"
}

cmd_rotate() {
  local action="${1:-}" orientation
  case "$action" in
    auto)
      orientation="$(sensor_orientation)" ||
        die "no accelerometer orientation; use a fixed rotation"
      rm -f "$LOCK_STATE"
      apply_rotation "$orientation" || exit 1
      ;;
    next | prev)
      lock_now
      orientation="$(cycle_orientation "$action")"
      apply_rotation "$orientation" || exit 1
      ;;
    normal | right | inverted | left)
      lock_now
      apply_rotation "$action" || exit 1
      ;;
    *)
      die "usage: krw-tablet rotate normal|right|inverted|left|next|prev|auto"
      ;;
  esac
}

cmd_lock() {
  local action="${1:-}"
  case "$action" in
    on) lock_now ;;
    off) rm -f "$LOCK_STATE" ;;
    toggle)
      if is_locked; then
        rm -f "$LOCK_STATE"
      else
        lock_now
      fi
      ;;
    *) die "usage: krw-tablet lock on|off|toggle" ;;
  esac
}

cmd_mode() {
  local action="${1:-}" final current
  case "$action" in
    on | off) write_session_value "$MANUAL_STATE" "$action" ;;
    auto) rm -f "$MANUAL_STATE" ;;
    toggle)
      current="$(state_mode)"
      if [[ "$current" == "on" ]]; then
        write_session_value "$MANUAL_STATE" off
      else
        write_session_value "$MANUAL_STATE" on
      fi
      ;;
    *) die "usage: krw-tablet mode on|off|auto|toggle" ;;
  esac

  apply_mode force

  final="$(state_mode)"
  [[ -n "$final" ]] || final="$(desired_mode)"
  printf 'mode: %s (%s)\n' "$final" "$(mode_reason)"
}

cmd_switch() {
  local action="${1:-}"
  case "$action" in
    on | off) write_session_value "$SWITCH_STATE" "$action" ;;
    *) die "usage: krw-tablet switch on|off" ;;
  esac
  apply_mode
}

cmd_status() {
  local rotation applied raw switch_state mode desired

  desired="$(desired_mode)"
  mode="$(state_mode)"

  printf 'mode:     %s (%s)\n' "$desired" "$(mode_reason)"
  if [[ -n "$mode" && "$mode" != "$desired" ]]; then
    printf 'applied:  %s (daemon has not caught up)\n' "$mode"
  fi
  rotation="$(state_rotation)"
  applied="$(monitor_field transform)"

  printf 'rotation: %s (transform %s)\n' "$rotation" "$(orientation_transform "$rotation")"
  printf 'panel:    transform %s on %s\n' "${applied:-<not present>}" "$OUTPUT"
  if is_locked; then
    printf 'locked:   yes\n'
  else
    printf 'locked:   no\n'
  fi

  if raw="$(sensor_raw_orientation)"; then
    printf 'sensor:   %s%s\n' "$raw" "$(sensor_orientation >/dev/null 2>&1 && printf '' || printf ' (unmapped)')"
  else
    printf 'sensor:   unavailable\n'
  fi

  switch_state="$(session_value "$SWITCH_STATE" || true)"
  printf 'switch:   %s\n' "${switch_state:-unknown}"
  if keyboard_attached; then
    printf 'keyboard: attached\n'
  else
    printf 'keyboard: absent\n'
  fi

  if noctalia_running; then
    printf 'shell:    Noctalia, bar %s\n' "$(noctalia_bar_state)"
  fi

  printf 'output:   %s %s scale %s\n' "$OUTPUT" "$(monitor_mode)" "$(monitor_scale)"
}

cmd_probe() {
  local name node

  printf '== sensors ==\n'
  printf 'iio-sensor-proxy: %s\n' "$(systemctl is-active iio-sensor-proxy.service 2>/dev/null || true)"
  printf 'HasAccelerometer: %s\n' "$(sensor_property HasAccelerometer 2>/dev/null || printf '<no answer>')"
  printf 'AccelerometerOrientation: %s\n' "$(sensor_raw_orientation || printf '<unavailable>')"
  printf 'iio devices: %s\n' "$(ls /sys/bus/iio/devices 2>/dev/null | tr '\n' ' ')"

  printf '\n== session ==\n'
  printf 'HYPRLAND_INSTANCE_SIGNATURE: %s\n' "${HYPRLAND_INSTANCE_SIGNATURE:-<unset>}"
  printf 'hyprctl: %s\n' "$(command -v hyprctl || printf '<not found>')"

  printf '\n== panel ==\n'
  printf '%s: %s scale %s transform %s\n' "$OUTPUT" "$(monitor_mode)" \
    "$(monitor_scale)" "$(monitor_field transform)"

  printf '\n== digitizers ==\n'
  while IFS= read -r name; do
    [[ -n "$name" ]] && printf '%s\n' "$name"
  done < <(tablet_devices)

  printf '\n== tablet mode ==\n'
  printf 'mode: %s (%s)\n' "$(desired_mode)" "$(mode_reason)"
  printf 'switch: %s\n' "$(session_value "$SWITCH_STATE" || printf 'unknown')"

  printf '\n== keyboards ==\n'
  for node in /dev/input/by-path/*-kbd; do
    [[ -e "$node" ]] && printf '%s\n' "$node"
  done
  keyboard_attached || printf '<none>\n'

  printf '\n== shell (Noctalia) ==\n'
  printf 'noctalia: %s\n' "$(command -v noctalia || printf '<not found>')"
  if noctalia_running; then
    printf 'bar: %s (from the config; tablet mode overrides auto-hide while on)\n' \
      "$(noctalia_bar_state)"
    if noctalia_dock_enabled; then
      printf 'dock: enabled, auto-hide %s\n' "$(noctalia_auto_hide dock || printf '?')"
    else
      printf 'dock: disabled\n'
    fi
  else
    printf 'bar: <no running instance>\n'
  fi
}

case "${1:-}" in
  daemon) cmd_daemon ;;
  mode)
    shift
    cmd_mode "$@"
    ;;
  switch)
    shift
    cmd_switch "$@"
    ;;
  rotate)
    shift
    cmd_rotate "$@"
    ;;
  lock)
    shift
    cmd_lock "$@"
    ;;
  status) cmd_status ;;
  probe) cmd_probe ;;
  "" | -h | --help | help) usage ;;
  *) die "unknown command: $1 (see krw-tablet --help)" ;;
esac
