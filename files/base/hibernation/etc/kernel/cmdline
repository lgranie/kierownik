#
# This file provides extra kernel command line arguments that are appended to the
# default kernel command line that is set by bootc. The default command line
# includes:
#   - root=UUID=<root-partition-uuid>
#   - rw
#   - quiet
#
# See kernel-docs for more information about kernel command line arguments:
# https://www.kernel.org/doc/html/latest/admin-guide/kernel-parameters.html

# Enable hibernation support
resume=UUID=SWAP_UUID
