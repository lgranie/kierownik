#!/usr/bin/env bash

set -euo pipefail

for id in $(loginctl list-sessions -j | jq -r '.[] | .session'); do
  source <(loginctl show-session -p Type -p Name ${id})
  if [[ ${Type} =~ (wayland|x11) ]]; then
    # Run in the user manager so notify-send can wait for the click without
    # blocking this system service.
    systemd-run --machine=${Name}@.host --user --collect --quiet \
      /usr/bin/notify_session "$1" "$2" "${3:-}" "${4:-}" || true
  fi
done
