#!/usr/bin/env bash

#MISE description="Install cert from url"
#USAGE arg "[url]" help="Site url"
set -euo pipefail

if [[ -z "${usage_url:-}" ]]; then
  usage_url=$(gum input --placeholder "Site url, e.g. https://example.com")
fi

server="${usage_url#*://}"
server="${server%%/*}"
server_name="${server%%:*}"

[[ -n "${server_name}" ]] || { gum log -sl error "Could not parse host from URL."; exit 1; }
case "${server_name}" in
  *"/"* | *".."*) gum log -sl error "Unsafe host name: ${server_name}"; exit 1 ;;
esac

cert="/tmp/${server_name}.crt"
echo quit | openssl s_client -showcerts -servername "${server_name}" -connect "${server}" 2>/dev/null |
  sed -ne '/-----BEGIN CERTIFICATE-----/,/-----END CERTIFICATE-----/p' >"${cert}"
run0 install -m 0644 "${cert}" "/etc/pki/ca-trust/source/anchors/${server_name}.crt"
rm -f "${cert}"
run0 update-ca-trust extract
