[Unit]
Description=Kier Setup
ConditionPathExists=!/var/lib/firstboot.done
ConditionVirtualization=!vm
Before=greetd.service getty@tty1.service
After=home.mount systemd-homed.service

[Service]
Type=oneshot
Environment=TERM=linux
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
ExecStart=/usr/bin/firstboot

[Install]
WantedBy=default.target
