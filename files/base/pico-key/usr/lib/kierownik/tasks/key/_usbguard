#!/usr/bin/env bash
# Sourced by key/* tasks. No #MISE description: krw picker skips _-prefixed files.
# No-op unless usbguard.service is active. Allows given vid:pid pairs persistently.
# Usage: _usbguard_allow 2e8a:10ff 2e8a:10fe ... ; returns 0 when a Pico is
# listed (and authorized), 1 when usbguard is active but no match is found.

_usbguard_allow() {
  local pids="${1:-2e8a:10ff 2e8a:10fe feff:fcfd}"
  systemctl is-active --quiet usbguard.service 2>/dev/null || return 0
  command -v usbguard >/dev/null 2>&1 || return 0
  local devs line num want found=0
  devs="$(usbguard list-devices 2>/dev/null)" || return 0
  for want in ${pids}; do
    line="$(printf '%s\n' "${devs}" | grep -i "id ${want} " | head -n 1 || true)"
    [[ -n "${line}" ]] || continue
    found=1
    num="${line%%:*}"
    if printf '%s\n' "${line}" | grep -q ': block'; then
      # ponytail: transient fallback if -p unsupported; rule lost on reboot, verify -p on hardware
      usbguard allow-device -p "${num}" 2>/dev/null || usbguard allow-device "${num}" 2>/dev/null || return 1
    fi
  done
  [[ "${found}" -eq 1 ]]
}
