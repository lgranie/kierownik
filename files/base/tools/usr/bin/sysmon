#!/usr/bin/env bash
set -oue pipefail

# sysmon — tmux system monitor in special:sysmon.
# Window "monitor": btop top, nvtop below. Window "services": systemd-manager-tui.
# Window "containers": podman-tui.
# SUPER+S toggles special:sysmon natively.

SESSION="sysmon"

usage() {
  gum style --border thick "sysmon — tmux system monitor" \
    "Usage: sysmon" \
    "Attaches to the sysmon tmux session (creates layout once)."
}

err() {
  gum log -sl error "$1"
  gum confirm "Close window?" || true
}

need() {
  command -v "$1" >/dev/null 2>&1 || {
    err "$1 not installed. Rebuild image first."
    exit 1
  }
}

bootstrap() {
  need btop
  need nvtop
  need systemd-manager-tui
  need podman-tui
  tmux has-session -t "${SESSION}" 2>/dev/null && return 0
  tmux new-session -ds "${SESSION}" -n monitor btop
  tmux split-window -vd -p 45 -t "${SESSION}:monitor" nvtop
  tmux new-window -d -t "${SESSION}" -n services systemd-manager-tui
  tmux new-window -d -t "${SESSION}" -n containers podman-tui
  tmux select-window -t "${SESSION}:monitor"
}

attach() {
  need tmux
  bootstrap
  if [[ -n "${TMUX:-}" ]]; then
    exec tmux switch-client -t "${SESSION}"
  fi
  exec tmux attach-session -t "${SESSION}"
}

case "${1:-}" in
  -h | --help)
    usage
    exit 0
    ;;
  "") attach ;;
  *)
    err "usage: sysmon"
    exit 1
    ;;
esac
