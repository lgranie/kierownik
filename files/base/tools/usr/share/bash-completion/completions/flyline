# shellcheck shell=bash
# bash completion for flyline: files/dirs before subcommands/options.
# System-wide compspec; filename must match the command name.
_flyline() {
  local cur="${COMP_WORDS[COMP_CWORD]}"
  local cmds="version time set-agent-mode create-prompt-widget set-style set-cursor key log run-tutorial editor history suggestions mouse perf changelog upgrade settings help"
  mapfile -t COMPREPLY < <(compgen -f -- "$cur"; compgen -W "$cmds --help --version" -- "$cur")
}

complete -o filenames -F _flyline flyline
