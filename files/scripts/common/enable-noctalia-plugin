#!/usr/bin/env bash
#
# Enable one Noctalia plugin by id at build time.
# Usage: enable-noctalia-plugin <author/plugin-id>
#   e.g. enable-noctalia-plugin gabedunn/voxtype
#
# Appends the id to `enabled = [...]` in the image system config at
# ${NOCTALIA_SYSTEM_PLUGINS_TOML:-/usr/lib/kierownik/noctalia/config/plugins-sources.toml},
# creating the file (with the kierownik path source) when the noctalia recipe
# has not run yet, so recipe order never matters. Idempotent: re-runs are no-ops.
# Noctalia resolves the id from its git sources on first boot (needs network once).
# Test override: NOCTALIA_SYSTEM_PLUGINS_TOML=/tmp/test-plugins-sources.toml

set -oue pipefail

ID="${1:?usage: enable-noctalia-plugin <author/plugin-id>}"
TARGET="${NOCTALIA_SYSTEM_PLUGINS_TOML:-/usr/lib/kierownik/noctalia/config/plugins.toml}"

if [[ ! "${ID}" =~ ^[^/[:space:]]+/[^/[:space:]]+$ ]]; then
    echo "enable-noctalia-plugin: invalid plugin id '${ID}' (want author/name)" >&2
    exit 1
fi

if [[ ! -f "${TARGET}" ]]; then
    mkdir -p "$(dirname "${TARGET}")"
    cat > "${TARGET}" <<'EOF'
[plugins]
enabled = []

EOF
fi

if grep -qF "\"${ID}\"" "${TARGET}"; then
    echo "enable-noctalia-plugin: ${ID} already enabled"
    exit 0
fi

# Append inside the enabled = [...] line (single-line array by convention).
grep -Eq '^enabled = \[.*\]$' "${TARGET}" || {
    echo "enable-noctalia-plugin: no single-line 'enabled = [...]' in ${TARGET}" >&2
    exit 1
}

tmp="$(mktemp)"
awk -v id="${ID}" '
/^enabled = \[.*\]$/ && !done {
    sub(/\]$/, ", \"" id "\"]")
    sub(/^enabled = \[, /, "enabled = [")
    done = 1
}
{ print }
' "${TARGET}" > "${tmp}"
cat "${tmp}" > "${TARGET}"
rm -f "${tmp}"

grep -qF "\"${ID}\"" "${TARGET}" || {
    echo "enable-noctalia-plugin: append failed for ${ID}" >&2
    exit 1
}

if command -v python3 >/dev/null; then
    python3 -c "import tomllib; d = tomllib.load(open('${TARGET}','rb')); assert '${ID}' in d['plugins']['enabled'], 'id missing after edit'" || {
        echo "enable-noctalia-plugin: ${TARGET} invalid TOML after edit" >&2
        exit 1
    }
fi

echo "enable-noctalia-plugin: ${ID} enabled"
