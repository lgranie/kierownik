#!/usr/bin/env bash

set -euo pipefail

repo="${1:-}"
pattern="${2:-}"
no_pre="${3:-}"

[[ -n "$repo" ]] || exit 0

releases="$(curl --silent --retry 3 "https://api.github.com/repos/${repo}/releases?per_page=30" 2>/dev/null || true)"
[[ -n "$releases" ]] || exit 0

if [[ -n "$pattern" ]]; then
  filter='[ .[]'
  if [[ "$no_pre" == "--no-pre" ]]; then
    filter+=' | select(.prerelease | not)'
  fi
  filter+=' | select(any(.assets[]?; (.name // "") | test($p))) ] | .[0].assets[] | select(.name | test($p)) | .browser_download_url'
  printf '%s\n' "$releases" | jq -r --arg p "$pattern" "$filter" 2>/dev/null | head -n 1
else
  filter='[ .[]'
  if [[ "$no_pre" == "--no-pre" ]]; then
    filter+=' | select(.prerelease | not)'
  fi
  filter+=' | select((.assets | length) > 0) ] | .[0].assets[0].browser_download_url'
  printf '%s\n' "$releases" | jq -r "$filter" 2>/dev/null | head -n 1
fi