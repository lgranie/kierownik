[Unit]
Description=Laya - English System 1 decision model API
ConditionUser=!@system
Wants=network-online.target
After=network-online.target
# Stays warm: ai_router dials the container directly (host loopback is
# unreachable from pasta guests), so idle-stop would strand routing on a
# stopped classifier. Small ONNX model — cheap to keep resident.
# StopWhenUnneeded=yes

[Container]
# Locally built by laya-build.service (`mise run laya:build`)
# from the Chainguard-based Containerfile; no registry pull.
Image=localhost/laya:latest
ContainerName=laya
# Shared bridge with ai_router/freellmapi (pasta guests cannot reach host loopback).
Network=llm.network
Environment=LAYA_ONNX_MODEL=inferenceprince/laya-onnx
Environment=HF_HUB_CACHE=/cache
# Backend port: the public 8008 is held by laya-proxy.socket and
# forwarded here by laya-proxy.service. Localhost-only either way.
PublishPort=127.0.0.1:8009:8000
# ONNX bundle (~846 MB fp16 weights); survives rebuilds.
Volume=%h/.local/share/laya:/cache:Z
# iGPU passthrough (780M on 8745HS, Intel iGPU on 5290). onnxruntime uses
# CPU provider, so this stays future-proofing for a GPU provider.
AddDevice=/dev/dri
# Model load needs >10s on CPU (bundle fetch + ORT init); default
# podman stop -t 10 hits SIGKILL. Keep below TimeoutStopSec.
StopTimeout=60
# Host-local servers (if needed) via podman-builtin host.containers.internal.
# No healthcheck: quadlet HealthCmd becomes CMD-SHELL, but the Chainguard
# runtime has no shell, so every probe fails and its transient unit trips
# fumon on each run. Liveness is covered by wait-ready + socket activation.
HealthCmd=none

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStopSec=120
# Idle stop (StopWhenUnneeded) kills the container via ExecStop's
# `podman rm -f`, so the main process exits 137 - a clean stop, not a failure.
SuccessExitStatus=137
