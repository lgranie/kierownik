#!/usr/bin/env bash

#MISE description="Show Laya status and API URL"
set -oue pipefail

URL="http://localhost:8008"

gum style --border thick "Laya status (on demand)"

if systemctl --user is-active --quiet laya-proxy.socket; then
  gum log -sl info "socket: listening on ${URL}"
else
  gum log -sl warn "socket: inactive — run: mise run laya:init"
fi

if systemctl --user is-active --quiet laya.service; then
  gum log -sl info "container: running"
else
  gum log -sl info "container: stopped (starts on first request)"
fi

if curl -fsS "${URL}/health" >/dev/null 2>&1; then
  gum log -sl info "api: reachable at ${URL}"
  gum style "POST ${URL}/predict with {state, questions} for typed decisions."
else
  gum log -sl warn "api: unreachable at ${URL} — check: mise run laya:logs"
fi
