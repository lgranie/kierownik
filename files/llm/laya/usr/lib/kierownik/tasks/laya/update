#!/usr/bin/env bash

#MISE description="Update Laya to the latest PyPI release (rebuilds only if newer)"
set -euo pipefail

# --- config (group-specific) ---
IMAGE="localhost/laya:latest"
REPO="inferenceprince/laya-onnx"
BUILD_TASK="laya:build"

# --- shared logic (mirror in tasks/freellmapi/update) ---
podman image inspect "${IMAGE}" >/dev/null 2>&1 || {
  gum log -sl info "Image not found — building now."
  mise run "${BUILD_TASK}"
  exit 0
}

REMOTE="$(curl --silent --retry 3 "https://huggingface.co/api/models/${REPO}" | jq -r '.sha // empty' 2>/dev/null | cut -c1-7 || true)"

if [[ -z "${REMOTE}" ]]; then
  gum log -sl error "error: could not query latest revision — check network" >&2
  exit 1
fi

if podman image inspect "localhost/laya:onnx-${REMOTE}" >/dev/null 2>&1; then
  gum log -sl info "Already at latest revision: ${REMOTE}"
  exit 0
fi

gum log -sl info "Updating to revision: ${REMOTE}"

mise run "${BUILD_TASK}"

# --- group hook: restart the on-demand backend onto the fresh image ---
# Stopped containers are auto-removed (quadlet ExecStop), so the next
# on-demand start picks up the fresh image by itself.
if systemctl --user is-active --quiet laya.service; then
  systemctl --user restart laya.service
  gum log -sl info "Laya restarted on the fresh image."
else
  gum log -sl info "Image rebuilt. The next request starts the new image on demand."
fi
