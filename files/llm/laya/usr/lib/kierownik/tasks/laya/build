#!/usr/bin/env bash

#MISE description="Build (or rebuild) the Laya Podman image"
set -oue pipefail

REPO="inferenceprince/laya-onnx"

systemctl --user start laya-build.service

gum log -sl info "Image 'localhost/laya:latest' built successfully."

# Tag with the ONNX bundle revision too. Short sha of the HF repo.
SHA="$(curl --silent --retry 3 "https://huggingface.co/api/models/${REPO}" | jq -r '.sha // empty' 2>/dev/null | cut -c1-7 || true)"
if [[ -n "${SHA}" ]]; then
  podman tag localhost/laya:latest "localhost/laya:onnx-${SHA}"
  gum log -sl info "Tagged 'localhost/laya:onnx-${SHA}'."
fi
