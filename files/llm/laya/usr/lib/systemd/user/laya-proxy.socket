[Unit]
Description=Laya on-demand socket (starts the container on first connection)
ConditionUser=!@system
After=network.target

[Socket]
# Public endpoint. Must differ from the container backend (127.0.0.1:8009):
# systemd holds this port, so the container cannot forward it.
ListenStream=127.0.0.1:8008

[Install]
WantedBy=sockets.target
