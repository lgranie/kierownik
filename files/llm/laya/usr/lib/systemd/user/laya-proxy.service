[Unit]
Description=Laya on-demand proxy (forwards to the container, stops it when idle)
ConditionUser=!@system
Requires=laya.service
After=laya.service

[Service]
# The socket queues connections while the container boots; only start
# forwarding once the backend answers.
ExecStartPre=/usr/lib/kierownik/laya/wait-ready
ExecStart=/usr/lib/systemd/systemd-socket-proxyd --exit-idle-time=600s 127.0.0.1:8009
