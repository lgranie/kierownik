[Unit]
Description=Ollama ROCm Container
After=local-fs.target

[Container]
ContainerName=ollama-rocm
Image=docker.io/ollama/ollama:rocm
PublishPort=11434:11434
Volume=%h/.cache/ollama:/root/.ollama:Z
PodmanArgs=--device /dev/kfd --device /dev/dri --group-add keep-groups --security-opt label=type:container_runtime_t

Environment="HOME=/var/cache/ollama"
Environment="OLLAMA_HOST=0.0.0.0:11434"
Environment="OLLAMA_MODELS=/var/cache/ollama/models"
Environment="OLLAMA_NUM_PARALLEL=4"
Environment="OLLAMA_MAX_LOADED_MODELS=1"
Environment="OLLAMA_KEEP_ALIVE=30m"
Environment="OLLAMA_IGPU_ENABLE=1"
Environment="HSA_OVERRIDE_GFX_VERSION=11.0.0"

[Service]
Restart=always

[Install]
WantedBy=default.target
