#!/usr/bin/env bash
# ai-chains — inspect and update ai_router chains.
# status: show eligible models per chain (freellmapi owns the final pick).
# tune:   interactively edit a chain in ~/.config/ai_router/config.yml,
#         validate, restart router, resync freellmapi profiles.
# add:    scaffold a new chain, then same validate/apply path as tune.
set -oue pipefail

URL="http://localhost:3003"
CONF_DIR="${HOME}/.config/ai_router"
CHAINS_FILE="${CONF_DIR}/config.yml"

need_init() {
  if [[ ! -f "${CHAINS_FILE}" ]]; then
    gum log -sl error "No ${CHAINS_FILE} — run: mise run ai_router:init"
    exit 1
  fi
}

fetch_chains() {
  local out
  out="$(curl -fsS "${URL}/chains" 2>/dev/null)" || out=""
  if [[ -z "${out}" ]]; then
    gum log -sl error "ai_router unreachable at ${URL} — check: mise run ai_router:logs"
    exit 1
  fi
  printf '%s' "${out}"
}

cmd_status() {
  fetch_chains | python3 -c "
import json, sys
raw = sys.stdin.read()
if not raw.strip():
    sys.exit(0)  # fetch_chains already reported the error
doc = json.loads(raw)
for name, ch in doc['chains'].items():
    models = ch['models'] or ['(empty — no eligible models)']
    print('== %s: %s [%d eligible]' % (name, ch['description'], len(ch['models'])))
    for m in models[:10]:
        print('   -', m)
    if len(ch['models']) > 10:
        print('   ... (+%d more)' % (len(ch['models']) - 10))
"
}

# Mirror of server _validate_config: chat mandatory, description per chain,
# requires in {tools, vision}, context.min a non-negative int.
validate() {
  python3 - "${CHAINS_FILE}" <<'PY'
import sys
try:
    import yaml
except ImportError:
    print("warn: no pyyaml, skipping client-side validation (server fails fast)")
    sys.exit(0)
with open(sys.argv[1]) as f:
    cfg = yaml.safe_load(f)
assert isinstance(cfg, dict) and isinstance(cfg.get("chains"), dict) and cfg["chains"], \
    "config needs a non-empty 'chains' mapping"
assert "chat" in cfg["chains"], "config needs a 'chat' chain (mandatory fallback)"
for name, ch in cfg["chains"].items():
    assert isinstance(ch, dict) and ch.get("description"), \
        "chain %r needs 'description'" % (name,)
    for req in ch.get("requires") or []:
        assert req in ("tools", "vision"), \
            "chain %r: unknown requires %r (allowed: tools, vision)" % (name, req)
    ctx = (ch.get("context") or {}).get("min", 0)
    assert isinstance(ctx, int) and ctx >= 0, \
        "chain %r: context.min must be a non-negative int" % (name,)
print("config.yml valid")
PY
}

apply_and_sync() {
  validate
  systemctl --user restart ai_router.service
  sleep 8  # startup syncs freellmapi profiles before serving
  systemctl --user restart freellmapi.service
  gum style --border thick "Chains updated — profiles synced, freellmapi restarted."
  cmd_status
}

chain_names() {
  python3 -c "import yaml,sys; print('\n'.join(yaml.safe_load(open('${CHAINS_FILE}'))['chains']))"
}

cmd_tune() {
  need_init
  NAME="$(chain_names | gum filter --limit 1 --header "Tune chain" --placeholder "Pick chain")"
  [[ -n "${NAME:-}" ]] || exit 0
  FIELD="$(printf 'description\nrequires\ncontext.min' | gum filter --limit 1 --header "Field of ${NAME}")"
  [[ -n "${FIELD:-}" ]] || exit 0
  CURRENT="$(python3 - "${CHAINS_FILE}" "${NAME}" "${FIELD}" <<'PY'
import yaml, sys
ch = yaml.safe_load(open(sys.argv[1]))["chains"][sys.argv[2]]
f = sys.argv[3]
if f == "requires":
    print(",".join(ch.get("requires") or []))
elif f == "context.min":
    print((ch.get("context") or {}).get("min", 0))
else:
    print(ch.get(f, ""))
PY
)"
  VALUE="$(gum input --header "${NAME}.${FIELD} (requires: comma list of tools,vision; empty clears)" --value "${CURRENT}")"
  python3 - "${CHAINS_FILE}" "${NAME}" "${FIELD}" "${VALUE}" <<'PY'
import yaml, sys
path, name, field, value = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
with open(path) as f:
    cfg = yaml.safe_load(f)
if field == "requires":
    cfg["chains"][name]["requires"] = [r.strip() for r in value.split(",") if r.strip()]
elif field == "context.min":
    cfg["chains"][name].setdefault("context", {})["min"] = int(value)
else:
    cfg["chains"][name][field] = value
with open(path, "w") as f:
    yaml.safe_dump(cfg, f, default_flow_style=False, allow_unicode=True)
PY
  gum log -sl info "Set ${NAME}.${FIELD}, validating ..."
  apply_and_sync
}

cmd_add() {
  need_init
  NAME="${1:-}"
  if [[ -z "${NAME}" ]]; then
    NAME="$(gum input --header "New chain name (large variant: <base>-large auto-routes past threshold)")"
  fi
  if [[ -z "${NAME}" ]]; then
    gum log -sl error "Empty name."
    exit 1
  fi
  if chain_names | grep -qx "${NAME}"; then
    gum log -sl error "Chain '${NAME}' already exists — use tune."
    exit 1
  fi
  DESC="$(gum input --header "One-line description (used by laya to classify prompts)")"
  REQ="$(gum input --header "requires (comma list of tools,vision; empty for none)" --value "")"
  CTX="$(gum input --header "context.min tokens" --value "8000")"
  python3 - "${CHAINS_FILE}" "${NAME}" "${DESC}" "${REQ}" "${CTX}" <<'PY'
import yaml, sys
path, name, desc, req, ctx = sys.argv[1:6]
with open(path) as f:
    cfg = yaml.safe_load(f)
cfg["chains"][name] = {
    "description": desc,
    "requires": [r.strip() for r in req.split(",") if r.strip()],
    "context": {"min": int(ctx)},
}
with open(path, "w") as f:
    yaml.safe_dump(cfg, f, default_flow_style=False, allow_unicode=True)
PY
  gum log -sl info "Added '${NAME}', validating ..."
  apply_and_sync
}

case "${1:-status}" in
  status) cmd_status ;;
  tune) cmd_tune ;;
  add) cmd_add "${2:-}" ;;
  -h | --help) gum style --border thick "ai-chains status|tune|add [name]" ;;
  *) gum log -sl error "unknown subcommand: $1" ; exit 1 ;;
esac
