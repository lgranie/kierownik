#!/usr/bin/env bash

#MISE description="Show ai_router status and chains"
set -oue pipefail

ENV_FILE="${HOME}/.config/ai_router/ai_router.env"
URL="http://localhost:3003"

gum style --border thick "ai_router status (on demand)"

if [[ ! -f "${ENV_FILE}" ]]; then
  gum log -sl warn "Not initialized — run: mise run ai_router:init"
  exit 1
fi
gum log -sl info "env: ${ENV_FILE}"

if systemctl --user is-active --quiet ai_router-proxy.socket; then
  gum log -sl info "socket: listening on ${URL}"
else
  gum log -sl warn "socket: inactive — run: mise run ai_router:init"
fi

if systemctl --user is-active --quiet ai_router.service; then
  gum log -sl info "container: running"
else
  gum log -sl info "container: stopped (starts on first request)"
fi

if curl -fsS "${URL}/health" >/dev/null 2>&1; then
  gum log -sl info "api: reachable at ${URL}"
  gum style "Point any OpenAI client at ${URL}/v1 (model auto, or chain-<name> to pin a chain)."
else
  gum log -sl warn "api: unreachable at ${URL} — check: mise run ai_router:logs"
fi
