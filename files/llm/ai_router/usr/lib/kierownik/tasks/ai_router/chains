#!/usr/bin/env bash

#MISE description="Show ai_router chains and eligible models per chain"
set -oue pipefail

URL="http://localhost:3003"

CHAINS_JSON="$(curl -fsS "${URL}/chains" 2>/dev/null || true)"
if [[ -z "${CHAINS_JSON}" ]]; then
  gum log -sl error "ai_router unreachable at ${URL} — check: mise run ai_router:logs"
  exit 1
fi

python3 -c "
import json, sys
doc = json.load(sys.stdin)
for name, ch in doc['chains'].items():
    ms = ch['models']
    print('== %s: %s [%d eligible]' % (name, ch['description'], len(ms)))
    for m in ms[:10] or ['(empty — no eligible models)']:
        print('   -', m)
    if len(ms) > 10:
        print('   ... (+%d more)' % (len(ms) - 10))
" <<<"${CHAINS_JSON}"
