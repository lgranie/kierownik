#!/usr/bin/env bash

#MISE description="Build (or rebuild) the pi Podman image"
set -euo pipefail

systemctl --user start pi_less_yolo-build.service

gum log -sl info "Image 'localhost/pi_less_yolo:latest' built successfully."

# Tag with the pi version too. Read from the image itself (no API race).
VERSION="$(podman run --rm --entrypoint cat localhost/pi_less_yolo:latest /usr/local/lib/node_modules/@earendil-works/pi-coding-agent/package.json 2>/dev/null | jq -r '.version // empty' || true)"
if [[ -n "${VERSION}" ]]; then
  podman tag localhost/pi_less_yolo:latest "localhost/pi_less_yolo:${VERSION}"
  gum log -sl info "Tagged 'localhost/pi_less_yolo:${VERSION}'."
fi
