#!/usr/bin/env bash

#MISE description="Update pi to the latest release (rebuilds only if newer)"
set -euo pipefail

# --- config (group-specific) ---
IMAGE="localhost/pi_less_yolo:latest"
PKG_JSON="/usr/local/lib/node_modules/@earendil-works/pi-coding-agent/package.json"
REPO="earendil-works/pi"
BUILD_TASK="pi:build"

# --- shared logic (mirror in tasks/freellmapi/update) ---
podman image inspect "${IMAGE}" >/dev/null 2>&1 || {
  gum log -sl info "Image not found — building now."
  mise run "${BUILD_TASK}"
  exit 0
}

CURRENT="$(podman run --rm --entrypoint cat "${IMAGE}" "${PKG_JSON}" 2>/dev/null | jq -r '.version // empty' || true)"
LATEST="$(curl --silent --retry 3 "https://api.github.com/repos/${REPO}/releases/latest" | jq -r '.tag_name // empty' 2>/dev/null || true)"
LATEST="${LATEST#v}"

if [[ -z "${LATEST}" ]]; then
  gum log -sl error "error: could not query latest release — check network" >&2
  exit 1
fi

if [[ "${CURRENT}" == "${LATEST}" ]]; then
  gum log -sl info "Already at latest version: ${CURRENT:-unknown}"
  exit 0
fi

gum log -sl info "Updating: ${CURRENT:-unknown} → ${LATEST}"

mise run "${BUILD_TASK}"

# --- group hook: none. pi containers are --rm ephemeral,
# so the next run picks up the fresh image by itself. ---
