#!/usr/bin/env bash
# Wait for a container backend to answer (socket activation path).
# Used as ExecStartPre by *-proxy.service so queued connections are only
# forwarded once the backend is up. Usage: wait-ready <url> [tries=180].
set -oue pipefail

URL="${1:?usage: wait-ready <url> [tries]}"
TRIES="${2:-180}"

for _ in $(seq 1 "${TRIES}"); do
  if curl -fsS "${URL}" >/dev/null 2>&1; then
    exit 0
  fi
  sleep 0.5
done

echo "backend did not answer ${URL} within $((TRIES / 2))s" >&2
exit 1
