[Unit]
Description=FreeLLMAPI - one OpenAI-compatible endpoint across free LLM tiers
ConditionUser=!@system
Wants=network-online.target
After=network-online.target
# On-demand backend for freellmapi-proxy.socket: started on first connection
# via freellmapi-proxy.service, stopped when the proxy goes idle.
StopWhenUnneeded=yes

[Container]
# Locally built by freellmapi-build.service (`mise run freellmapi:build`)
# from the Chainguard-based Containerfile; no registry pull.
Image=localhost/freellmapi:latest
ContainerName=freellmapi
Environment=NODE_ENV=production
Environment=PORT=3001
# Created by `mise run freellmapi:init` (ENCRYPTION_KEY, mode 600) before the
# on-demand socket is enabled, so it always exists when the container starts.
# (No `-` optional prefix: quadlet treats it as a relative path and mangles it.)
EnvironmentFile=%h/.config/freellmapi/freellmapi.env
# Backend port: the public 3001 is held by freellmapi-proxy.socket and
# forwarded here by freellmapi-proxy.service. Localhost-only either way.
PublishPort=127.0.0.1:3002:3001
Volume=%h/.local/share/freellmapi:/app/server/data:Z
# Node needs >10s for graceful shutdown (SQLite checkpoint); default
# podman stop -t 10 hits SIGKILL. Keep below TimeoutStopSec so systemd
# never kills podman rm first.
StopTimeout=30
# Lets custom providers reach host-local servers (ramalama, ollama, ...).
AddHost=host.docker.internal:host-gateway
# No healthcheck: quadlet HealthCmd becomes CMD-SHELL, but the Chainguard
# runtime has no shell, so every probe fails and its transient unit trips
# fumon on each run. Liveness is covered by wait-ready + socket activation.
HealthCmd=none

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStopSec=60
# Idle stop (StopWhenUnneeded) kills the container via ExecStop's
# `podman rm -f`, so the main process exits 137 - a clean stop, not a failure.
SuccessExitStatus=137
