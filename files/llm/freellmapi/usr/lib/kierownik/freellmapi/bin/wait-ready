#!/usr/bin/env bash
# Wait for the FreeLLMAPI container backend to answer.
# Used as ExecStartPre by freellmapi-proxy.service so queued connections are
# only forwarded once the backend is up (socket activation path).
set -oue pipefail

URL="http://127.0.0.1:3002/api/ping"

for _ in $(seq 1 180); do
  if curl -fsS "${URL}" > /dev/null 2>&1; then
    exit 0
  fi
  sleep 0.5
done

echo "freellmapi backend did not answer ${URL} within 90s" >&2
exit 1
