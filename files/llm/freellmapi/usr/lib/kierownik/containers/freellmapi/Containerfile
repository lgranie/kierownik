FROM cgr.dev/chainguard/node:latest-dev AS builder

# Chainguard node defaults to the non-root `node` user; apk needs root.
USER root

# git/curl/jq: fetch the source at the latest release tag.
# python3/make/build-base: compile-from-source fallback for native modules
# (better-sqlite3, sharp) when no prebuilt binary matches the Node version.
RUN apk add --no-cache git curl ca-certificates jq python3 make build-base

WORKDIR /src

# Latest release tag; fall back to the default branch if the API is unreachable.
RUN <<EORUN
    set -e
    TAG=$(curl --silent --retry 3 "https://api.github.com/repos/tashfeenahmed/freellmapi/releases/latest" | jq -r '.tag_name // empty' 2>/dev/null || true)
    if [ -n "${TAG}" ]; then
      git clone --depth 1 --branch "${TAG}" https://github.com/tashfeenahmed/freellmapi.git .
    else
      git clone --depth 1 https://github.com/tashfeenahmed/freellmapi.git .
    fi
EORUN

# npm 12 disables "remote" (arbitrary-URL tarball) fetches by default; the
# upstream lockfile pins one dep to an npmmirror.com tarball, so opt back in.
# The URL is lockfile-pinned and integrity-checked.
RUN npm ci --allow-remote=all
# npm 12 also blocks dependency install scripts until approved. better-sqlite3
# (SQLite driver, compiled from source: no Node 26 prebuild) and esbuild
# (client build) are required; the rest (e.g. msw) stays blocked and is pruned
# with the dev dependencies below.
RUN npm install-scripts approve better-sqlite3 esbuild
RUN npm rebuild better-sqlite3 esbuild
RUN npm run build
RUN npm prune --omit=dev

FROM cgr.dev/chainguard/node:latest AS runtime

# Rootless Podman maps container root to the unprivileged host user, which
# owns the bind-mounted data dir. Same tradeoff as upstream's USER root
# entrypoint (it chowns the data dir, then drops back to node).
USER root
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3001
ENV FREELLMAPI_INSTALL_METHOD=docker

COPY --from=builder /src/package.json /src/package-lock.json ./
COPY --from=builder /src/node_modules ./node_modules
# npm nests some production packages under the workspace instead of hoisting
# them (undici lives at server/node_modules/undici). Upstream copies this path
# explicitly; without it proxied requests silently go direct (upstream #550).
COPY --from=builder /src/server/node_modules ./server/node_modules
COPY --from=builder /src/shared ./shared
COPY --from=builder /src/server/package.json ./server/package.json
# The dashboard shows which release this is; the version lives in
# desktop/package.json (server/package.json tracks the workspace, not the app).
COPY --from=builder /src/desktop/package.json ./desktop/package.json
COPY --from=builder /src/server/dist ./server/dist
COPY --from=builder /src/client/dist ./client/dist
COPY files/healthcheck.js /app/healthcheck.js

EXPOSE 3001

# Exec-array form: the runtime image has no shell. Quadlet also sets this via
# HealthCmd; the duplication keeps plain `podman run` usage healthy too.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD ["node", "/app/healthcheck.js"]

# The base image's entrypoint is /usr/bin/node, which would swallow CMD, so
# set the full entrypoint explicitly.
ENTRYPOINT ["node", "server/dist/index.js"]
