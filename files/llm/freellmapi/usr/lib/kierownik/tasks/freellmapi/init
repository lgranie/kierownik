#!/usr/bin/env bash

#MISE description="Initialize FreeLLMAPI (encryption key, data dir, image, on-demand socket)"
set -oue pipefail

ENV_FILE="${HOME}/.config/freellmapi/freellmapi.env"
DATA_DIR="${HOME}/.local/share/freellmapi"
URL="http://localhost:3001"

mkdir -p "$(dirname "${ENV_FILE}")" "${DATA_DIR}"

if [[ -f "${ENV_FILE}" ]]; then
  gum log -sl info "Keeping existing ${ENV_FILE} (encryption key preserved)"
else
  KEY="$(openssl rand -hex 32)"
  umask 077
  printf 'ENCRYPTION_KEY=%s\n' "${KEY}" >"${ENV_FILE}"
  umask 022
  gum log -sl info "Wrote ${ENV_FILE} with a fresh ENCRYPTION_KEY"
fi

chmod 600 "${ENV_FILE}"

podman image inspect "localhost/freellmapi:latest" >/dev/null 2>&1 || mise run freellmapi:build

gum log -sl info "Probing ${URL}/api/ping (starts the container on demand) ..."
for _ in $(seq 1 30); do
  if curl -fsS "${URL}/api/ping" >/dev/null 2>&1; then
    HEALTHY=1
    break
  fi
  sleep 2
done

if [[ "${HEALTHY:-0}" == "1" ]]; then
  gum style --border thick "FreeLLMAPI is running on demand at ${URL}"
  gum style "Next: add provider keys on the Keys page, then point any OpenAI client at ${URL}/v1 with the unified key."
  gum style "Idle for a bit and the container stops itself; the next request starts it again."
else
  gum log -sl error "The API did not answer within 60s — check: mise run freellmapi:logs"
  exit 1
fi
