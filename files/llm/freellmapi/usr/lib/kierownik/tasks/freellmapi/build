#!/usr/bin/env bash

#MISE description="Build (or rebuild) the FreeLLMAPI Podman image"
set -oue pipefail

systemctl --user start freellmapi-build.service

gum log -sl info "Image 'localhost/freellmapi:latest' built successfully."

# Tag with the app version too. Read from the image itself (no API race:
# the dashboard version lives in desktop/package.json, copied at build).
VERSION="$(podman run --rm --entrypoint cat localhost/freellmapi:latest /app/desktop/package.json 2>/dev/null | jq -r '.version // empty' || true)"
if [[ -n "${VERSION}" ]]; then
  podman tag localhost/freellmapi:latest "localhost/freellmapi:${VERSION}"
  gum log -sl info "Tagged 'localhost/freellmapi:${VERSION}'."
fi
