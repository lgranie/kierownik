[Unit]
Description=FreeLLMAPI on-demand proxy (forwards to the container, stops it when idle)
ConditionUser=!@system
Requires=freellmapi.service
After=freellmapi.service

[Service]
# The socket queues connections while the container boots; only start
# forwarding once the backend answers.
ExecStartPre=/usr/lib/kierownik/freellmapi/wait-ready
ExecStart=/usr/lib/systemd/systemd-socket-proxyd --exit-idle-time=600s 127.0.0.1:3002
