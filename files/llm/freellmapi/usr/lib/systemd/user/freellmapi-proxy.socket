[Unit]
Description=FreeLLMAPI on-demand socket (starts the container on first connection)
After=network.target

[Socket]
# Public endpoint. Must differ from the container backend (127.0.0.1:3002):
# systemd holds this port, so the container cannot forward it.
ListenStream=127.0.0.1:3001

[Install]
WantedBy=sockets.target
