#!/usr/bin/env bash
#MISE description="Launch ramalama with per-model tuning"
#USAGE arg "[model]" help="Model to run"
set -oue pipefail

get_model_description() {
    local model="$1"
    local shortnames="/usr/share/ramalama/shortnames.conf"
    local desc=""

    while IFS= read -r line; do
        if [[ "$line" == "#"* ]]; then
            desc="${line#\# }"
        elif [[ "$line" == *"\"$model\""* ]]; then
            echo "$desc"
            return
        fi
    done < "$shortnames"
    echo ""
}

# Generic per-model tuning parser: reads KEY=value from the shortnames comment.
# Falls back to the given default when the key is absent (env vars win later).
extract_key() {
    local desc="$1" key="$2" default="$3"
    echo "$desc" | grep -oP "${key}=\K[^, ]+" || echo "$default"
}

if [[ -z "${usage_target:-}" ]]; then
    models=$(grep -oP '^"\K[^"]+(?=")' /usr/share/ramalama/shortnames.conf | sort -u)
    model=$(echo "$models" | while read -r m; do
        desc=$(get_model_description "$m")
        ctx=$(extract_key "$desc" "LLM_CONTEXT" "8192")
        temp=$(extract_key "$desc" "LLM_TEMPERATURE" "0.7")
        ngl=$(extract_key "$desc" "LLM_GPU_LAYERS" "40")
        echo "$m - $desc (ctx=${ctx}, temp=${temp}, ngl=${ngl})"
    done | gum choose --header "Select model" --selected "${LLM_DEFAULT_MODEL:-qwen3.8:ud-iq4_xs}")
    usage_target=$(echo "$model" | awk '{print $1}')
fi

# Per-model tuning from shortnames.conf (matches the Ramalama args column in doc/llm.md).
# Explicit env vars (LLM_CONTEXT=... mise run llm:serve ...) always override these.
selected_desc=$(get_model_description "$usage_target")
LLM_CONTEXT="${LLM_CONTEXT:-$(extract_key "$selected_desc" "LLM_CONTEXT" "8192")}"
LLM_GPU_LAYERS="${LLM_GPU_LAYERS:-$(extract_key "$selected_desc" "LLM_GPU_LAYERS" "40")}"
LLM_TOP_P="${LLM_TOP_P:-$(extract_key "$selected_desc" "LLM_TOP_P" "0.95")}"
LLM_TEMPERATURE="${LLM_TEMPERATURE:-$(extract_key "$selected_desc" "LLM_TEMPERATURE" "0.7")}"
LLM_REPEAT_PENALTY="${LLM_REPEAT_PENALTY:-$(extract_key "$selected_desc" "LLM_REPEAT_PENALTY" "1.1")}"
LLM_TOP_K="${LLM_TOP_K:-$(extract_key "$selected_desc" "LLM_TOP_K" "")}"

# Defaults tuned for 8745HS (32GB shared RAM, Radeon 780M iGPU)
LLM_CONTEXT="${LLM_CONTEXT:-8192}"
LLM_GPU_LAYERS="${LLM_GPU_LAYERS:-40}"
LLM_TOP_P="${LLM_TOP_P:-0.95}"
LLM_TEMPERATURE="${LLM_TEMPERATURE:-0.7}"
LLM_REPEAT_PENALTY="${LLM_REPEAT_PENALTY:-1.1}"

# NOTE: reasoning controls need no CLI flags. Muse Glimmer's template defaults
# reasoning_strength to high; Qwen thinking models enable thinking by default.

runtime_args="--top-p ${LLM_TOP_P} --repeat-penalty ${LLM_REPEAT_PENALTY}"
if [[ -n "${LLM_TOP_K}" ]]; then
    runtime_args="${runtime_args} --top-k ${LLM_TOP_K}"
fi

gum log -sl info "Serving ramalama with model: ${usage_target} (ctx=${LLM_CONTEXT}, temp=${LLM_TEMPERATURE}, top_p=${LLM_TOP_P}, top_k=${LLM_TOP_K:-default}, repeat=${LLM_REPEAT_PENALTY}, ngl=${LLM_GPU_LAYERS})"
ramalama serve "${usage_target}" -c "${LLM_CONTEXT}" --ngl "${LLM_GPU_LAYERS}" --temp "${LLM_TEMPERATURE}" --runtime-args "${runtime_args}"
