set -oue pipefail

# Test hibernation configuration

gum style --border thick "=== Hibernation Configuration Test ==="

# Test 1: Check swap configuration
gum log -sl info "Test 1: Checking swap configuration..."
if ! swapon --show=NAME --noheadings | grep -v '^/dev/zram' | grep -q '^/dev/'; then
    gum log -sl error "❌ No block-device swap partition found (zram cannot be used for hibernation)"
    exit 1
fi
gum log -sl info "✓ Swap partition detected"

# Test 2: Check swap size
gum log -sl info "Test 2: Checking swap size..."
local mem_total=$(free -b | awk '/^Mem:/ {print $2}')
local swap_size=$(swapon --show=NAME,SIZE --noheadings --bytes | awk '/^\/dev\/zram/ {next} {sum+=$2} END {print sum+0}')
gum log -sl info "  Memory: $mem_total bytes"
gum log -sl info "  Swap: $swap_size bytes"

if [ "$swap_size" -lt "$mem_total" ]; then
    gum log -sl error "❌ Swap is smaller than memory"
    exit 1
fi
gum log -sl info "✓ Swap is large enough for hibernation"

# Test 3: Check HibernateLocation support (systemd auto-detection)
gum log -sl info "Test 3: Checking systemd HibernateLocation support..."
if systemctl is-enabled systemd-hibernate-resume.service >/dev/null 2>&1; then
    gum log -sl info "✓ systemd-hibernate-resume.service enabled"
elif [ -x /usr/lib/systemd/system-generators/systemd-hibernate-resume-generator ]; then
    gum log -sl info "✓ systemd-hibernate-resume-generator available"
else
    gum log -sl warn "⚠ systemd-hibernate-resume generator not found"
fi

# Test 4: Check systemd hibernate service
gum log -sl info "Test 4: Checking systemd hibernate service..."
if systemctl list-unit-files | grep -q "systemd-hibernate.service"; then
    gum log -sl info "✓ systemd-hibernate.service found"
else
    gum log -sl error "❌ systemd-hibernate.service not found"
    exit 1
fi

# Test 5: Check dracut configuration
gum log -sl info "Test 5: Checking dracut configuration..."
if [ -f /etc/dracut.conf.d/hibernation.conf ]; then
    gum log -sl info "✓ Dracut hibernation configuration found"
else
    gum log -sl warn "⚠ Dracut hibernation configuration not found"
fi

# Test 6: Check initramfs
gum log -sl info "Test 6: Checking initramfs..."
local initramfs=$(ls /boot/initramfs-* 2>/dev/null | head -1)
if [ -n "$initramfs" ]; then
    gum log -sl info "  Initramfs: $initramfs"
    if lsinitrd -f /lib/systemd/system/systemd-hibernate.service "$initramfs" >/dev/null 2>&1; then
        gum log -sl info "✓ Initramfs contains hibernation support"
    else
        gum log -sl warn "⚠ Initramfs may not contain hibernation support"
    fi
else
    gum log -sl warn "⚠ No initramfs found"
fi

gum style --border thick "=== Test Complete ==="
gum log -sl info "Summary:"
gum log -sl info "  - Swap: $swap_size bytes ($((swap_size/1024/1024/1024)) GB)"
gum log -sl info "  - Memory: $mem_total bytes ($((mem_total/1024/1024/1024)) GB)"
gum log -sl info "  - Hibernation supported: YES"

gum style --border thick "To hibernate, use:" "  systemctl hibernate" "" "Or with Hyprland keybindings:" "  SUPER + CTRL + ALT + H (Hibernate)" "  SUPER + CTRL + ALT + S (Suspend)" "  SUPER + CTRL + ALT + P (Hybrid Sleep)"
