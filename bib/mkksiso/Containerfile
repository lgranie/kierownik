# Minimal container providing the `mkksiso` toolchain for injecting a
# kickstart into a generic Fedora installer ISO.
#
# mkksiso (from lorax) shells out to xorriso/osirrox, implantisomd5 and
# mkefiboot, so we bundle those here to avoid installing them on the host.
# The `lorax` package brings in xorriso + isomd5sum as dependencies.
FROM registry.fedoraproject.org/fedora-minimal:44

RUN microdnf install --setopt=install_weak_deps=False -y lorax && microdnf clean all
