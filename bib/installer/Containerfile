# Installer-environment container for the bootc-generic-iso live installer.
#
# image-builder (bootc-generic-iso) requires the `--bootc-ref` container to be
# a LIVE environment conforming to the image-builder ISO contract:
#   - x86_64 UEFI+legacy boot via shim/GRUB2 and a kernel+initramfs at
#     /images/pxeboot/{vmlinuz,initrd.img}
#   - /usr/lib/bootc-image-builder/iso.yaml with the GRUB2 menu + ISO label
#   - anaconda installed and set as the default boot target (this tui
#     installer applies the kickstart in interactive-defaults.ks)
#   - the build tools xorriso/mksquashfs present
FROM quay.io/fedora/fedora-bootc:44

COPY src/ /src/

RUN bash /src/build.sh && rm -rf /src
